<?xml version="1.0"?>
<settings version="1">
    <section id="@PKG_ADDON_ID@">
        <category id="general" label="30100">
            <group id="1" label="30101">
                <setting id="displayoverride" type="boolean" label="30120">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" />
                </setting>
                <setting id="displayconfig" type="integer" label="30121" help="30122">
                    <level>0</level>
                    <default>0</default>
                    <dependencies>
                        <dependency type="visible" setting="displayoverride">true</dependency>
                    </dependencies>
                    <constraints>
                        <options>
                            <option label="30123">0</option>    <!-- default -->
                            <option label="30124">1</option>    <!-- 3840x2160 -->
                            <option label="30125">2</option>    <!-- 1920x1080 -->
                            <option label="30126">3</option>    <!-- 1280x720 -->
                            <option label="30127">999</option>  <!-- custom -->
                        </options>
                    </constraints>
                    <control type="spinner" format="string" />
                </setting>
                <setting id="customdisplayconfig" type="string" label="30128">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="visible" setting="displayoverride">true</dependency>
                        <dependency type="visible" setting="displayconfig" operator="is">999</dependency>
                    </dependencies>
                    <control type="edit" format="string">
                        <heading>30128</heading>
                    </control>
                </setting>
            </group>
            <group id="2" label="30102">
                <setting id="audiochannels" type="integer" label="30140">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="30141">0</option>    <!-- default -->
                            <option label="30142">2</option>    <!-- Stereo -->
                            <option label="30143">6</option>    <!-- 5.1 -->
                            <option label="30144">8</option>    <!-- 7.1 -->
                        </options>
                    </constraints>
                    <control type="spinner" format="string" />
                </setting>
                <setting id="customaudio" type="boolean" label="30145">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" />
                </setting>
                <setting id="customaudiodevice" type="string" label="30146" help="30147">
                    <level>0</level>
                    <default>ALSA:sysdefault</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="visible" setting="customaudio">true</dependency>
                    </dependencies>
                    <control type="edit" format="string">
                        <heading>30146</heading>
                    </control>
                </setting>
            </group>
        </category>
    </section>
</settings>
