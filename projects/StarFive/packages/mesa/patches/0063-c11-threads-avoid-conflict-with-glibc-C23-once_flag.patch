From: LibreELEC
Subject: [PATCH] c11/threads: avoid conflict with glibc C23 once_flag/call_once

glibc >= 2.43 declares once_flag and call_once() in <stdlib.h> when C23 or
_GNU_SOURCE is in effect. Use the libc definitions when they exist.
---
diff --git a/include/c11/threads_posix.h b/include/c11/threads_posix.h
index 802526a..56d8c2f 100644
--- a/include/c11/threads_posix.h
+++ b/include/c11/threads_posix.h
@@ -49,9 +49,14 @@ Configuration macro:
 
 
 #include <pthread.h>
+/* glibc >= 2.43 declares once_flag/call_once in <stdlib.h> (C23, also
+   with _GNU_SOURCE): pull it in first so the checks below see it. */
+#include <stdlib.h>
 
 /*---------------------------- macros ----------------------------*/
+#ifndef ONCE_FLAG_INIT
 #define ONCE_FLAG_INIT PTHREAD_ONCE_INIT
+#endif
 #ifdef INIT_ONCE_STATIC_INIT
 #define TSS_DTOR_ITERATIONS PTHREAD_DESTRUCTOR_ITERATIONS
 #else
@@ -66,7 +71,9 @@ typedef pthread_cond_t  cnd_t;
 typedef pthread_t       thrd_t;
 typedef pthread_key_t   tss_t;
 typedef pthread_mutex_t mtx_t;
+#ifndef __once_flag_defined
 typedef pthread_once_t  once_flag;
+#endif
 
 
 /*
@@ -89,12 +96,14 @@ impl_thrd_routine(void *p)
 
 
 /*--------------- 7.25.2 Initialization functions ---------------*/
+#ifndef __once_flag_defined
 // 7.25.2.1
 static inline void
 call_once(once_flag *flag, void (*func)(void))
 {
     pthread_once(flag, func);
 }
+#endif
 
 
 /*------------- 7.25.3 Condition variable functions -------------*/
