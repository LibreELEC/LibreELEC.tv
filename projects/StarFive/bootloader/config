# SPL loads u-boot.itb from GPT partition 4 (partitions 1 and 2 are the
# LibreELEC system and storage partitions)
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_PARTITION=0x4
# do not pick up a (vendor) environment from SPI flash when booting from SD:
# it may carry a stale fdtfile and bootcmd
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
CONFIG_ENV_IS_NOWHERE=y
# host tool for UEFI capsules, needs gnutls on the build host; not used
# CONFIG_TOOLS_MKEFICAPSULE is not set
# the VisionFive 2 Lite powers its M.2 slot through a fixed regulator
# (vpcie3v3-supply), see patches/u-boot
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_FIXED=y
