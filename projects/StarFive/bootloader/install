# SPL with the StarFive header (loaded by the boot ROM) and the
# OpenSBI + U-Boot FIT image (loaded by the SPL)
cp -av spl/u-boot-spl.bin.normal.out ${INSTALL}/usr/share/bootloader
cp -av u-boot.itb ${INSTALL}/usr/share/bootloader
