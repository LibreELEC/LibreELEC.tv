# The board boots with the U-Boot in its SPI flash. Its distro boot finds
# extlinux/extlinux.conf on the bootable FAT partition and loads the device
# tree ${fdtfile} (e.g. starfive/jh7110-starfive-visionfive-2-v1.3b.dtb, set
# from the board EEPROM) relative to FDTDIR, so one image serves every board
# revision.

echo "image: copying device tree blobs..."
mmd starfive >"${SAVE_ERROR}" 2>&1 || show_error
mcopy "${RELEASE_DIR}/3rdparty/bootloader/starfive/"*.dtb ::/starfive >"${SAVE_ERROR}" 2>&1 || show_error

echo "image: copying extlinux.conf..."
mkdir -p "${IMG_TMP}/extlinux"
cat <<EOF2 >"${IMG_TMP}/extlinux/extlinux.conf"
LABEL ${DISTRO}
  LINUX /${KERNEL_NAME}
  FDTDIR /
  APPEND boot=UUID=${UUID_SYSTEM} disk=UUID=${UUID_STORAGE} quiet ${EXTRA_CMDLINE}
EOF2
mcopy -s "${IMG_TMP}/extlinux" :: >"${SAVE_ERROR}" 2>&1 || show_error
