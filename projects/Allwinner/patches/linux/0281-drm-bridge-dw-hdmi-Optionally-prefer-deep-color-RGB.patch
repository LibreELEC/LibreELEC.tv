From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Thu, 01 Oct 2026 12:55:15 +0200
Subject: [PATCH] drm/bridge: dw-hdmi: Optionally prefer deep color RGB

Output bus formats are ordered with RGB888 ahead of every deep color
format, so deep color is never negotiated as long as the bridge chain
accepts RGB888, which it always does. HDR content then gets quantized
to 8 bits whenever the mode doesn't use YUV 4:2:0. Add a platform
field with the highest TMDS character rate up to which deep color
RGB should be preferred. When it is set, 12-bit and 10-bit RGB are
offered ahead of RGB888 if max_bpc and the sink allow them and the
resulting TMDS rate fits both that limit and the sink's. Platforms
which don't set it keep the current order.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c | 46 ++++++++++++++++++++++-
 include/drm/bridge/dw_hdmi.h              |  8 ++++
 2 files changed, 52 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index f15f7522fdac..d7da04cf7b7a 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -2699,6 +2699,27 @@ static int dw_hdmi_connector_create(struct dw_hdmi *hdmi)
  * - MEDIA_BUS_FMT_YUV8_1X24,
  */
 
+/*
+ * Check whether RGB at the given color depth fits within the TMDS character
+ * rate limit of both the platform and the sink. Sinks without a declared
+ * limit are assumed to support the HDMI 1.x default of 165 MHz.
+ */
+static bool dw_hdmi_deep_color_fits(struct dw_hdmi *hdmi,
+				    const struct drm_display_info *info,
+				    const struct drm_display_mode *mode,
+				    unsigned int bpc)
+{
+	unsigned int max = hdmi->plat_data->deep_color_max_tmds_clock;
+	unsigned long tmds = (unsigned long)mode->clock * bpc / 8;
+
+	if (info->max_tmds_clock)
+		max = min(max, (unsigned int)info->max_tmds_clock);
+	else
+		max = min(max, 165000U);
+
+	return tmds <= max;
+}
+
 /*
  * Can return a maximum of 15 possible output formats for a mode/connector:
  * four YUV 4:2:0 ones for modes which also allow other formats, followed
@@ -2712,12 +2733,14 @@ static u32 *dw_hdmi_bridge_atomic_get_output_bus_fmts(struct drm_bridge *bridge,
 					struct drm_connector_state *conn_state,
 					unsigned int *num_output_fmts)
 {
+	struct dw_hdmi *hdmi = bridge->driver_private;
 	struct drm_connector *conn = conn_state->connector;
 	struct drm_display_info *info = &conn->display_info;
 	struct drm_display_mode *mode = &crtc_state->mode;
 	u8 max_bpc = conn_state->max_requested_bpc;
 	bool is_hdmi2_sink = info->hdmi.scdc.supported ||
 			     (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR420));
+	bool rgb12_first = false, rgb10_first = false;
 	u32 *output_fmts;
 	unsigned int i = 0;
 
@@ -2772,6 +2795,23 @@ static u32 *dw_hdmi_bridge_atomic_get_output_bus_fmts(struct drm_bridge *bridge,
 	 * if supported. In any case the default RGB888 format is added
 	 */
 
+	/*
+	 * Prefer deep color RGB over 8-bit RGB where the platform asks for
+	 * it, so that e.g. HDR content isn't quantized to 8 bits.
+	 */
+	if (hdmi->plat_data->deep_color_max_tmds_clock) {
+		rgb12_first = max_bpc >= 12 && info->bpc >= 12 &&
+			      dw_hdmi_deep_color_fits(hdmi, info, mode, 12);
+		rgb10_first = max_bpc >= 10 && info->bpc >= 10 &&
+			      dw_hdmi_deep_color_fits(hdmi, info, mode, 10);
+	}
+
+	if (rgb12_first)
+		output_fmts[i++] = MEDIA_BUS_FMT_RGB121212_1X36;
+
+	if (rgb10_first)
+		output_fmts[i++] = MEDIA_BUS_FMT_RGB101010_1X30;
+
 	/* Default 8bit RGB fallback */
 	output_fmts[i++] = MEDIA_BUS_FMT_RGB888_1X24;
 
@@ -2789,7 +2829,8 @@ static u32 *dw_hdmi_bridge_atomic_get_output_bus_fmts(struct drm_bridge *bridge,
 		if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR444))
 			output_fmts[i++] = MEDIA_BUS_FMT_YUV12_1X36;
 
-		output_fmts[i++] = MEDIA_BUS_FMT_RGB121212_1X36;
+		if (!rgb12_first)
+			output_fmts[i++] = MEDIA_BUS_FMT_RGB121212_1X36;
 	}
 
 	if (max_bpc >= 10 && info->bpc >= 10) {
@@ -2799,7 +2840,8 @@ static u32 *dw_hdmi_bridge_atomic_get_output_bus_fmts(struct drm_bridge *bridge,
 		if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR444))
 			output_fmts[i++] = MEDIA_BUS_FMT_YUV10_1X30;
 
-		output_fmts[i++] = MEDIA_BUS_FMT_RGB101010_1X30;
+		if (!rgb10_first)
+			output_fmts[i++] = MEDIA_BUS_FMT_RGB101010_1X30;
 	}
 
 	if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422))
diff --git a/include/drm/bridge/dw_hdmi.h b/include/drm/bridge/dw_hdmi.h
index c08afc56c09c..85243a952272 100644
--- a/include/drm/bridge/dw_hdmi.h
+++ b/include/drm/bridge/dw_hdmi.h
@@ -147,6 +147,14 @@ struct dw_hdmi_plat_data {
 	 */
 	bool phy_max_tmds_msm_ctrl_quirk;
 
+	/*
+	 * Highest TMDS character rate in kHz up to which deep color RGB is
+	 * preferred over 8-bit RGB, if the sink and max_bpc allow it. Zero
+	 * keeps the default of only using deep color when nothing else in
+	 * the bridge chain accepts 8-bit RGB.
+	 */
+	unsigned int deep_color_max_tmds_clock;
+
 	/*
 	 * Private data passed to all the .mode_valid() and .configure_phy()
 	 * callback functions.
-- 
2.43.0

