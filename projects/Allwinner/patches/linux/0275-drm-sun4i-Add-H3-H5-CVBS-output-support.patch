+&mixer1 {
+	resets = <&display_clocks RST_MIXER1>;
+};
+
 &mmc0 {
 	compatible = "allwinner,sun50i-h5-mmc",
 		     "allwinner,sun50i-a64-mmc";
@@ -281,3 +299,7 @@ &rtc {
 &sid {
 	compatible = "allwinner,sun50i-h5-sid";
