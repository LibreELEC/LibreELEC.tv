From ac54674ae5d68b5d1f69762fe7fa0027961cc77d Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Thu, 10 Sep 2026 00:01:36 +0200
Subject: [PATCH] arm64: dts: allwinner: h616: add HDMI audio topology

Describe the H616 internal HDMI audio link at the SoC level using the
allwinner,sun8i-a83t-hdmi-audio machine driver binding, matching the
other sun4i/sun8i/sun50i SoCs: the CPU DAI is the audio hub's HDMI I2S
output (audio-cpu = <&ahub 1>). Leave the card disabled for boards to
opt in, and enable it (plus the audio hub) on every board that already
has HDMI enabled: X96 Mate, Orange Pi Zero2, Orange Pi Zero3, Transpeed
8K618-T and YuzukiHD Chameleon.

Generalizes the X96-Mate-only version of this topology (previously
gated behind "DO NOT MERGE" pending the H616 display pipeline, now
landed) into shared SoC-level DT.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 .../boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts     | 8 ++++++++
 arch/arm64/boot/dts/allwinner/sun50i-h616-x96-mate.dts    | 8 ++++++++
 arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi            | 8 ++++++++
 .../boot/dts/allwinner/sun50i-h618-orangepi-zero3.dts     | 8 ++++++++
 .../boot/dts/allwinner/sun50i-h618-transpeed-8k618-t.dts  | 8 ++++++++
 .../boot/dts/allwinner/sun50i-h618-yuzukihd-chameleon.dts | 8 ++++++++
 6 files changed, 48 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts b/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts
index 0d30c072fbd5..15cd47eb13a1 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts
@@ -13,6 +13,10 @@ / {
 	compatible = "xunlong,orangepi-zero2", "allwinner,sun50i-h616";
 };
 
+&ahub {
+	status = "okay";
+};
+
 &cpu0 {
 	cpu-supply = <&reg_dcdca>;
 };
@@ -33,6 +37,10 @@ &hdmi {
 	status = "okay";
 };
 
+&hdmi_sound {
+	status = "okay";
+};
+
 &mmc0 {
 	vmmc-supply = <&reg_dcdce>;
 };
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616-x96-mate.dts b/arch/arm64/boot/dts/allwinner/sun50i-h616-x96-mate.dts
index cac704821fd7..0787bf86bd79 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616-x96-mate.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616-x96-mate.dts
@@ -44,6 +44,10 @@ reg_vcc5v: vcc5v {
 	};
 };
 
+&ahub {
+	status = "okay";
+};
+
 &codec {
 	allwinner,audio-routing = "Line Out", "LINEOUT";
 	status = "okay";
@@ -81,6 +85,10 @@ hdmi_out_con: endpoint {
 	};
 };
 
+&hdmi_sound {
+	status = "okay";
+};
+
 &ir {
 	status = "okay";
 };
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
index cf7123630e9e..0df90b38fcd8 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
@@ -103,6 +103,13 @@ de: display-engine {
 		status = "disabled";
 	};
 
+	hdmi_sound: sound-hdmi {
+		compatible = "allwinner,sun8i-a83t-hdmi-audio";
+		audio-cpu = <&ahub 1>;
+		audio-codec = <&hdmi>;
+		status = "disabled";
+	};
+
 	reserved-memory {
 		#address-cells = <2>;
 		#size-cells = <2>;
@@ -1139,6 +1146,7 @@ ohci3: usb@5311400 {
 		};
 
 		hdmi: hdmi@6000000 {
+			#sound-dai-cells = <0>;
 			compatible = "allwinner,sun50i-h616-dw-hdmi",
 				     "allwinner,sun50i-h6-dw-hdmi";
 			reg = <0x06000000 0x10000>;
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h618-orangepi-zero3.dts b/arch/arm64/boot/dts/allwinner/sun50i-h618-orangepi-zero3.dts
index 4a1754eeb0b6..17130c1b7277 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h618-orangepi-zero3.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h618-orangepi-zero3.dts
@@ -13,6 +13,10 @@ / {
 	compatible = "xunlong,orangepi-zero3", "allwinner,sun50i-h618";
 };
 
+&ahub {
+	status = "okay";
+};
+
 &cpu0 {
 	cpu-supply = <&reg_dcdc2>;
 };
@@ -36,6 +40,10 @@ &hdmi {
 	status = "okay";
 };
 
+&hdmi_sound {
+	status = "okay";
+};
+
 &mmc0 {
 	/*
 	 * The schematic shows the card detect pin wired up to PF6, via an
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h618-transpeed-8k618-t.dts b/arch/arm64/boot/dts/allwinner/sun50i-h618-transpeed-8k618-t.dts
index c27e9bfc4fd1..ed6ec40a04f5 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h618-transpeed-8k618-t.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h618-transpeed-8k618-t.dts
@@ -63,6 +63,10 @@ wifi_pwrseq: pwrseq {
 	};
 };
 
+&ahub {
+	status = "okay";
+};
+
 &codec {
 	allwinner,audio-routing = "Line Out", "LINEOUT";
 	status = "okay";
@@ -100,6 +104,10 @@ hdmi_out_con: endpoint {
 	};
 };
 
+&hdmi_sound {
+	status = "okay";
+};
+
 &ir {
 	status = "okay";
 };
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h618-yuzukihd-chameleon.dts b/arch/arm64/boot/dts/allwinner/sun50i-h618-yuzukihd-chameleon.dts
index c0704d308e40..2cae96c757df 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h618-yuzukihd-chameleon.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h618-yuzukihd-chameleon.dts
@@ -54,6 +54,10 @@ wifi_pwrseq: pwrseq {
 	};
 };
 
+&ahub {
+	status = "okay";
+};
+
 &codec {
 	allwinner,audio-routing = "Line Out", "LINEOUT";
 	status = "okay";
@@ -94,6 +98,10 @@ hdmi_out_con: endpoint {
 	};
 };
 
+&hdmi_sound {
+	status = "okay";
+};
+
 &mmc0 {
 	bus-width = <4>;
 	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>;	/* PF6 */
-- 
