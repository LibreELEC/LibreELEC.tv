From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Mon, 20 Jul 2026 12:45:32 +0200
Subject: [PATCH] drm/bridge: dw-hdmi: Select PHY resource entry by output
 color depth

hdmi_phy_configure_dwc_hdmi_3d_tx() always indexes mpll_cfg->res[0]
and cur_ctr->curr[0], regardless of the negotiated output color
depth. The array index is DW_HDMI_RES_8/10/12, and every in-tree
platform table (imx, ingenic, rockchip, sun8i) is laid out with
explicit bpp8/bpp10/bpp12 columns, so this has always silently
applied the 8-bit analog PHY calibration even when 10-bit or 12-bit
color was negotiated.

Select the entry with hdmi_bus_fmt_color_depth(), which already
exists and handles every supported bus format. For 8-bit output
this is DW_HDMI_RES_8, identical to the previous hardcoded index, so
there is no behavior change for the common case.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>

---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c | 22 +++++++++++++++++++---
 1 file changed, 19 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index ad7103ddbf62..2d16337be23b 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -1590,6 +1590,22 @@ static int hdmi_phy_configure_dwc_hdmi_3d_tx(struct dw_hdmi *hdmi,
 	const struct dw_hdmi_mpll_config *mpll_config = pdata->mpll_cfg;
 	const struct dw_hdmi_curr_ctrl *curr_ctrl = pdata->cur_ctr;
 	const struct dw_hdmi_phy_config *phy_config = pdata->phy_config;
+	int depth = DW_HDMI_RES_8;
+
+	/*
+	 * YUV 4:2:2 is always sent at the 8-bit TMDS rate, with up to 12-bit
+	 * components packed into 24-bit pixels, so it uses the 8-bit entry.
+	 */
+	if (!hdmi_bus_fmt_is_yuv422(hdmi->hdmi_data.enc_out_bus_format)) {
+		switch (hdmi_bus_fmt_color_depth(hdmi->hdmi_data.enc_out_bus_format)) {
+		case 10:
+			depth = DW_HDMI_RES_10;
+			break;
+		case 12:
+			depth = DW_HDMI_RES_12;
+			break;
+		}
+	}
 
 	/*
 	 * The MPLL and current control tables are indexed by the pixel clock
@@ -1618,11 +1634,11 @@ static int hdmi_phy_configure_dwc_hdmi_3d_tx(struct dw_hdmi *hdmi,
 	    phy_config->mpixelclock == ~0UL)
 		return -EINVAL;
 
-	dw_hdmi_phy_i2c_write(hdmi, mpll_config->res[0].cpce,
+	dw_hdmi_phy_i2c_write(hdmi, mpll_config->res[depth].cpce,
 			      HDMI_3D_TX_PHY_CPCE_CTRL);
-	dw_hdmi_phy_i2c_write(hdmi, mpll_config->res[0].gmp,
+	dw_hdmi_phy_i2c_write(hdmi, mpll_config->res[depth].gmp,
 			      HDMI_3D_TX_PHY_GMPCTRL);
-	dw_hdmi_phy_i2c_write(hdmi, curr_ctrl->curr[0],
+	dw_hdmi_phy_i2c_write(hdmi, curr_ctrl->curr[depth],
 			      HDMI_3D_TX_PHY_CURRCTRL);
 
 	dw_hdmi_phy_i2c_write(hdmi, 0, HDMI_3D_TX_PHY_PLLPHBYCTRL);
