From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Wed, 30 Sep 2026 21:04:40 +0200
Subject: [PATCH] media: cedrus: Filter enumerated formats by depth and codec

Format lookup skips formats which don't match the stream bit depth or
source codec, but enumeration still lists them. Userspace then sees
AFBC formats on SoCs and codecs without AFBC output, 10-bit formats for
8-bit streams, and duplicate entries, and gets a different format when
it selects one of them.

Use the same checks for enumeration.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 .../staging/media/sunxi/cedrus/cedrus_video.c | 32 +++++++++++--------
 1 file changed, 19 insertions(+), 13 deletions(-)

diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_video.c b/drivers/staging/media/sunxi/cedrus/cedrus_video.c
index e43d1dbf4aed..0e443cdaf7cd 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_video.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_video.c
@@ -134,6 +134,23 @@ static struct cedrus_format cedrus_formats[] = {
 
 #define CEDRUS_FORMATS_COUNT	ARRAY_SIZE(cedrus_formats)
 
+static bool cedrus_format_is_valid(struct cedrus_ctx *ctx,
+				   const struct cedrus_format *fmt,
+				   u32 directions)
+{
+	if (!cedrus_is_capable(ctx, fmt->capabilities) ||
+	    !(fmt->directions & directions))
+		return false;
+
+	if (fmt->depth && fmt->depth != ctx->bit_depth)
+		return false;
+
+	if (fmt->src_format && fmt->src_format != ctx->src_fmt.pixelformat)
+		return false;
+
+	return true;
+}
+
 static struct cedrus_format *cedrus_find_format(struct cedrus_ctx *ctx,
 						u32 pixelformat, u32 directions)
 {
@@ -144,15 +161,7 @@ static struct cedrus_format *cedrus_find_format(struct cedrus_ctx *ctx,
 	for (i = 0; i < CEDRUS_FORMATS_COUNT; i++) {
 		fmt = &cedrus_formats[i];
 
-		if (!cedrus_is_capable(ctx, fmt->capabilities) ||
-		    !(fmt->directions & directions))
-			continue;
-
-		if (fmt->depth && fmt->depth != ctx->bit_depth)
-			continue;
-
-		if (fmt->src_format &&
-		    fmt->src_format != ctx->src_fmt.pixelformat)
+		if (!cedrus_format_is_valid(ctx, fmt, directions))
 			continue;
 
 		if (fmt->pixelformat == pixelformat)
@@ -297,10 +306,7 @@ static int cedrus_enum_fmt(struct file *file, struct v4l2_fmtdesc *f,
 	index = 0;
 
 	for (i = 0; i < CEDRUS_FORMATS_COUNT; i++) {
-		if (!cedrus_is_capable(ctx, cedrus_formats[i].capabilities))
-			continue;
-
-		if (!(cedrus_formats[i].directions & direction))
+		if (!cedrus_format_is_valid(ctx, &cedrus_formats[i], direction))
 			continue;
 
 		if (index == f->index)
-- 
