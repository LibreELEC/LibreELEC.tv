From db37aaf50a382033bcf7b66cdc48a6c02475d42f Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Fri, 4 Sep 2026 22:01:44 +0200
Subject: [PATCH] ASoC: sun4i-i2s: add HDMI IEC958 transport

Detect hdmi-codec from the already constructed ASoC runtime at DAI
startup. Expose IEC958_SUBFRAME_LE only when that runtime contains
hdmi-codec, and constrain the format out on every other link.

Translate canonical ALSA IEC958 subframes in place once the application
has handed them over, moving the 16-bit payload and PCUV bits into the
Synopsys BPCUV representation and deriving B from the Z preamble. Ask for
an explicit appl_ptr sync, so the translation also covers the mmap path,
where there is no copy to hook into.

For controller layouts with multiple transmit data lines, distribute
HDMI channels over up to four lines and restore the line configuration
after runtime resume. Ordinary PCM remains unchanged.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 sound/soc/sunxi/sun4i-i2s.c | 231 +++++++++++++++++++++++++++++++++---
 1 file changed, 216 insertions(+), 15 deletions(-)

diff --git a/sound/soc/sunxi/sun4i-i2s.c b/sound/soc/sunxi/sun4i-i2s.c
index 716fa4d872ff..c50b3aa1cb8f 100644
--- a/sound/soc/sunxi/sun4i-i2s.c
+++ b/sound/soc/sunxi/sun4i-i2s.c
@@ -16,14 +16,17 @@
 #include <linux/regmap.h>
 #include <linux/reset.h>
 
+#include <sound/asoundef.h>
 #include <sound/dmaengine_pcm.h>
+#include <sound/hdmi-codec.h>
+#include <sound/pcm.h>
 #include <sound/pcm_params.h>
 #include <sound/soc.h>
 #include <sound/soc-dai.h>
 
 #define SUN4I_I2S_CTRL_REG		0x00
 #define SUN4I_I2S_CTRL_SDO_EN_MASK		GENMASK(11, 8)
-#define SUN4I_I2S_CTRL_SDO_EN(sdo)			BIT(8 + (sdo))
+#define SUN4I_I2S_CTRL_SDO_EN_LINES(lines)		GENMASK(7 + (lines), 8)
 #define SUN4I_I2S_CTRL_MODE_MASK		BIT(5)
 #define SUN4I_I2S_CTRL_MODE_SLAVE			(1 << 5)
 #define SUN4I_I2S_CTRL_MODE_MASTER			(0 << 5)
@@ -120,8 +123,8 @@
 #define SUN8I_I2S_CHAN_CFG_TX_SLOT_NUM_MASK	GENMASK(3, 0)
 #define SUN8I_I2S_CHAN_CFG_TX_SLOT_NUM(chan)	(chan - 1)
 
-#define SUN8I_I2S_TX_CHAN_MAP_REG	0x44
-#define SUN8I_I2S_TX_CHAN_SEL_REG	0x34
+#define SUN8I_I2S_TX_CHAN_MAP_REG(pin)	(0x44 + 4 * (pin))
+#define SUN8I_I2S_TX_CHAN_SEL_REG(pin)	(0x34 + 4 * (pin))
 #define SUN8I_I2S_TX_CHAN_OFFSET_MASK		GENMASK(13, 12)
 #define SUN8I_I2S_TX_CHAN_OFFSET(offset)	(offset << 12)
 #define SUN8I_I2S_TX_CHAN_EN_MASK		GENMASK(11, 4)
@@ -151,6 +154,13 @@
 #define SUN50I_R329_I2S_RX_CHAN_MAP2_REG 0x70
 #define SUN50I_R329_I2S_RX_CHAN_MAP3_REG 0x74
 
+#define SUN4I_I2S_HDMI_PREAMBLE_B	0x8
+#define SUN4I_I2S_HDMI_PAYLOAD_MASK	GENMASK(27, 12)
+#define SUN4I_I2S_HDMI_PCUV_MASK	(IEC958_SUBFRAME_PARITY | \
+					 IEC958_SUBFRAME_CHANNEL_STATUS | \
+					 IEC958_SUBFRAME_USER_DATA | \
+					 IEC958_SUBFRAME_VALIDITY)
+
 struct sun4i_i2s;
 
 /**
@@ -172,6 +182,7 @@ struct sun4i_i2s;
  * @get_sr: callback to get sample resolution
  * @get_wss: callback to get word select size
  * @set_chan_cfg: callback to set channel configuration
+ * @set_hdmi_tx: callback to distribute channels over the HDMI I2S lanes
  * @set_fmt: callback to set format
  */
 struct sun4i_i2s_quirks {
@@ -205,6 +216,8 @@ struct sun4i_i2s_quirks {
 	int	(*set_chan_cfg)(const struct sun4i_i2s *i2s,
 				unsigned int channels,	unsigned int slots,
 				unsigned int slot_width);
+	void	(*set_hdmi_tx)(struct sun4i_i2s *i2s,
+			       unsigned int channels);
 	int	(*set_fmt)(const struct sun4i_i2s *i2s, unsigned int fmt);
 };
 
@@ -218,6 +231,8 @@ struct sun4i_i2s {
 	unsigned int	mclk_freq;
 	unsigned int	slots;
 	unsigned int	slot_width;
+	unsigned int	tx_lines;
+	snd_pcm_uframes_t	hdmi_appl;
 
 	struct snd_dmaengine_dai_dma_data	capture_dma_data;
 	struct snd_dmaengine_dai_dma_data	playback_dma_data;
@@ -230,6 +245,13 @@ struct sun4i_i2s {
 	const struct sun4i_i2s_quirks	*variant;
 };
 
+static bool sun4i_i2s_is_hdmi(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+
+	return snd_soc_rtdcom_lookup(rtd, HDMI_CODEC_DRV_NAME) != NULL;
+}
+
 struct sun4i_i2s_clk_div {
 	u8	div;
 	u8	val;
@@ -484,11 +506,11 @@ static int sun8i_i2s_set_chan_cfg(const struct sun4i_i2s *i2s,
 	unsigned int lrck_period;
 
 	/* Map the channels for playback and capture */
-	regmap_write(i2s->regmap, SUN8I_I2S_TX_CHAN_MAP_REG, 0x76543210);
+	regmap_write(i2s->regmap, SUN8I_I2S_TX_CHAN_MAP_REG(0), 0x76543210);
 	regmap_write(i2s->regmap, SUN8I_I2S_RX_CHAN_MAP_REG, 0x76543210);
 
 	/* Configure the channels */
-	regmap_update_bits(i2s->regmap, SUN8I_I2S_TX_CHAN_SEL_REG,
+	regmap_update_bits(i2s->regmap, SUN8I_I2S_TX_CHAN_SEL_REG(0),
 			   SUN4I_I2S_CHAN_SEL_MASK,
 			   SUN4I_I2S_CHAN_SEL(channels));
 	regmap_update_bits(i2s->regmap, SUN8I_I2S_RX_CHAN_SEL_REG,
@@ -522,7 +544,7 @@ static int sun8i_i2s_set_chan_cfg(const struct sun4i_i2s *i2s,
 			   SUN8I_I2S_FMT0_LRCK_PERIOD_MASK,
 			   SUN8I_I2S_FMT0_LRCK_PERIOD(lrck_period));
 
-	regmap_update_bits(i2s->regmap, SUN8I_I2S_TX_CHAN_SEL_REG,
+	regmap_update_bits(i2s->regmap, SUN8I_I2S_TX_CHAN_SEL_REG(0),
 			   SUN8I_I2S_TX_CHAN_EN_MASK,
 			   SUN8I_I2S_TX_CHAN_EN(channels));
 
@@ -590,6 +612,61 @@ static int sun50i_h6_i2s_set_chan_cfg(const struct sun4i_i2s *i2s,
 	return 0;
 }
 
+static void sun8i_i2s_set_hdmi_tx(struct sun4i_i2s *i2s,
+				  unsigned int channels)
+{
+	unsigned int lines = DIV_ROUND_UP(channels, 2);
+	unsigned int line;
+
+	i2s->tx_lines = lines;
+	regmap_update_bits(i2s->regmap, SUN4I_I2S_CTRL_REG,
+			   SUN4I_I2S_CTRL_SDO_EN_MASK,
+			   SUN4I_I2S_CTRL_SDO_EN_LINES(lines));
+
+	for (line = 0; line < lines; line++) {
+		unsigned int line_channels = min(channels - 2 * line, 2U);
+		unsigned int map = (2 * line + 1) << 4 | 2 * line;
+
+		regmap_write(i2s->regmap, SUN8I_I2S_TX_CHAN_MAP_REG(line), map);
+		regmap_update_bits(i2s->regmap,
+				   SUN8I_I2S_TX_CHAN_SEL_REG(line),
+				   SUN8I_I2S_TX_CHAN_OFFSET_MASK |
+				   SUN8I_I2S_TX_CHAN_EN_MASK |
+				   SUN4I_I2S_CHAN_SEL_MASK,
+				   SUN8I_I2S_TX_CHAN_OFFSET(1) |
+				   SUN8I_I2S_TX_CHAN_EN(line_channels) |
+				   SUN4I_I2S_CHAN_SEL(line_channels));
+	}
+}
+
+static void sun50i_h6_i2s_set_hdmi_tx(struct sun4i_i2s *i2s,
+				      unsigned int channels)
+{
+	unsigned int lines = DIV_ROUND_UP(channels, 2);
+	unsigned int line;
+
+	i2s->tx_lines = lines;
+	regmap_update_bits(i2s->regmap, SUN4I_I2S_CTRL_REG,
+			   SUN4I_I2S_CTRL_SDO_EN_MASK,
+			   SUN4I_I2S_CTRL_SDO_EN_LINES(lines));
+
+	for (line = 0; line < lines; line++) {
+		unsigned int line_channels = min(channels - 2 * line, 2U);
+		unsigned int map = (2 * line + 1) << 4 | 2 * line;
+
+		regmap_write(i2s->regmap,
+			     SUN50I_H6_I2S_TX_CHAN_MAP1_REG(line), map);
+		regmap_update_bits(i2s->regmap,
+				   SUN50I_H6_I2S_TX_CHAN_SEL_REG(line),
+				   SUN50I_H6_I2S_TX_CHAN_SEL_OFFSET_MASK |
+				   SUN50I_H6_I2S_TX_CHAN_EN_MASK |
+				   SUN50I_H6_I2S_TX_CHAN_SEL_MASK,
+				   SUN50I_H6_I2S_TX_CHAN_SEL_OFFSET(1) |
+				   SUN50I_H6_I2S_TX_CHAN_EN(line_channels) |
+				   SUN50I_H6_I2S_TX_CHAN_SEL(line_channels));
+	}
+}
+
 static int sun4i_i2s_hw_params(struct snd_pcm_substream *substream,
 			       struct snd_pcm_hw_params *params,
 			       struct snd_soc_dai *dai)
@@ -616,6 +693,10 @@ static int sun4i_i2s_hw_params(struct snd_pcm_substream *substream,
 		return ret;
 	}
 
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK &&
+	    sun4i_i2s_is_hdmi(substream) && i2s->variant->set_hdmi_tx)
+		i2s->variant->set_hdmi_tx(i2s, channels);
+
 	/* Set significant bits in our FIFOs */
 	regmap_update_bits(i2s->regmap, SUN4I_I2S_FIFO_CTRL_REG,
 			   SUN4I_I2S_FIFO_CTRL_TX_MODE_MASK |
@@ -770,7 +851,7 @@ static int sun8i_i2s_set_soc_fmt(const struct sun4i_i2s *i2s,
 
 	regmap_update_bits(i2s->regmap, SUN4I_I2S_CTRL_REG,
 			   SUN8I_I2S_CTRL_MODE_MASK, mode);
-	regmap_update_bits(i2s->regmap, SUN8I_I2S_TX_CHAN_SEL_REG,
+	regmap_update_bits(i2s->regmap, SUN8I_I2S_TX_CHAN_SEL_REG(0),
 			   SUN8I_I2S_TX_CHAN_OFFSET_MASK,
 			   SUN8I_I2S_TX_CHAN_OFFSET(offset));
 	regmap_update_bits(i2s->regmap, SUN8I_I2S_RX_CHAN_SEL_REG,
@@ -878,7 +959,7 @@ static int sun50i_h6_i2s_set_soc_fmt(const struct sun4i_i2s *i2s,
 
 	regmap_update_bits(i2s->regmap, SUN4I_I2S_CTRL_REG,
 			   SUN8I_I2S_CTRL_MODE_MASK, mode);
-	regmap_update_bits(i2s->regmap, SUN8I_I2S_TX_CHAN_SEL_REG,
+	regmap_update_bits(i2s->regmap, SUN8I_I2S_TX_CHAN_SEL_REG(0),
 			   SUN50I_H6_I2S_TX_CHAN_SEL_OFFSET_MASK,
 			   SUN50I_H6_I2S_TX_CHAN_SEL_OFFSET(offset));
 	regmap_update_bits(i2s->regmap, SUN50I_H6_I2S_RX_CHAN_SEL_REG,
@@ -1101,14 +1182,47 @@ static int sun4i_i2s_dai_startup(struct snd_pcm_substream *sub, struct snd_soc_d
 {
 	struct sun4i_i2s *i2s = snd_soc_dai_get_drvdata(dai);
 	struct snd_pcm_runtime *runtime = sub->runtime;
+	u64 formats = i2s->variant->pcm_formats;
+	bool hdmi = false;
+	int ret;
+
+	if (sub->stream == SNDRV_PCM_STREAM_PLAYBACK)
+		hdmi = sun4i_i2s_is_hdmi(sub);
+
+	if (hdmi)
+		formats |= SNDRV_PCM_FMTBIT_IEC958_SUBFRAME_LE;
+
+	ret = snd_pcm_hw_constraint_mask64(runtime, SNDRV_PCM_HW_PARAM_FORMAT,
+					   formats);
+	if (ret || !hdmi)
+		return ret;
+
+	/*
+	 * IEC958 subframes are rewritten once the application has handed them
+	 * over, so every appl_ptr update has to reach the driver, mmap or not.
+	 */
+	runtime->hw.info |= SNDRV_PCM_INFO_SYNC_APPLPTR |
+			    SNDRV_PCM_INFO_NO_REWINDS;
+
+	return 0;
+}
+
+static int sun4i_i2s_dai_prepare(struct snd_pcm_substream *sub,
+				 struct snd_soc_dai *dai)
+{
+	struct sun4i_i2s *i2s = snd_soc_dai_get_drvdata(dai);
 
-	return snd_pcm_hw_constraint_mask64(runtime, SNDRV_PCM_HW_PARAM_FORMAT,
-					    i2s->variant->pcm_formats);
+	/* The application pointer starts over from zero after prepare. */
+	if (sub->stream == SNDRV_PCM_STREAM_PLAYBACK)
+		i2s->hdmi_appl = 0;
+
+	return 0;
 }
 
 static const struct snd_soc_dai_ops sun4i_i2s_dai_ops = {
 	.probe		= sun4i_i2s_dai_probe,
 	.startup	= sun4i_i2s_dai_startup,
+	.prepare	= sun4i_i2s_dai_prepare,
 	.hw_params	= sun4i_i2s_hw_params,
 	.set_fmt	= sun4i_i2s_set_fmt,
 	.set_sysclk	= sun4i_i2s_set_sysclk,
@@ -1134,17 +1248,86 @@ static struct snd_soc_dai_driver sun4i_i2s_dai = {
 		.channels_min = 1,
 		.channels_max = 8,
 		.rates = SNDRV_PCM_RATE_8000_192000,
-		.formats = SUN4I_FORMATS_ALL,
+		.formats = SUN4I_FORMATS_ALL |
+			   SNDRV_PCM_FMTBIT_IEC958_SUBFRAME_LE,
 	},
 	.ops = &sun4i_i2s_dai_ops,
 	.symmetric_rate = 1,
 };
 
+static void sun4i_i2s_hdmi_convert(struct snd_pcm_runtime *runtime,
+				   snd_pcm_uframes_t offset,
+				   snd_pcm_uframes_t frames)
+{
+	__le32 *ptr = (__le32 *)(runtime->dma_area +
+				 frames_to_bytes(runtime, offset));
+	__le32 *end = ptr + frames * runtime->channels;
+
+	for (; ptr < end; ptr++) {
+		u32 sample = le32_to_cpu(*ptr);
+		u32 hdmi = (sample & SUN4I_I2S_HDMI_PAYLOAD_MASK) >> 1;
+
+		/* Move P, C, U and V from bits 31:28 to bits 30:27. */
+		hdmi |= (sample & SUN4I_I2S_HDMI_PCUV_MASK) >> 1;
+
+		/* ALSA's Z preamble marks the first frame of an IEC958 block. */
+		if ((sample & IEC958_SUBFRAME_PREAMBLE_MASK) ==
+		    SUN4I_I2S_HDMI_PREAMBLE_B)
+			hdmi |= BIT(31);
+
+		*ptr = cpu_to_le32(hdmi);
+	}
+}
+
+/*
+ * Translate the subframes the application just handed over, in place. The
+ * conversion has to happen after the data has been written and before the
+ * hardware reads it, which is exactly the window this callback runs in.
+ */
+static int sun4i_i2s_pcm_ack(struct snd_soc_component *component,
+			     struct snd_pcm_substream *substream)
+{
+	struct sun4i_i2s *i2s = snd_soc_component_get_drvdata(component);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	snd_pcm_uframes_t appl, offset, frames;
+
+	if (runtime->format != SNDRV_PCM_FORMAT_IEC958_SUBFRAME_LE)
+		return 0;
+
+	appl = runtime->control->appl_ptr;
+	frames = appl - i2s->hdmi_appl;
+	if ((snd_pcm_sframes_t)frames < 0)
+		frames += runtime->boundary;
+
+	/* A rewind leaves nothing to translate. */
+	if (frames > runtime->buffer_size) {
+		i2s->hdmi_appl = appl;
+		return 0;
+	}
+
+	offset = i2s->hdmi_appl % runtime->buffer_size;
+	while (frames) {
+		snd_pcm_uframes_t chunk = min(frames,
+					      runtime->buffer_size - offset);
+
+		sun4i_i2s_hdmi_convert(runtime, offset, chunk);
+
+		offset = (offset + chunk) % runtime->buffer_size;
+		frames -= chunk;
+	}
+
+	i2s->hdmi_appl = appl;
+
+	return 0;
+}
+
 static const struct snd_soc_component_driver sun4i_i2s_component = {
 	.name			= "sun4i-dai",
+	.ack			= sun4i_i2s_pcm_ack,
 	.legacy_dai_naming	= 1,
 };
 
