From 52ae5cdd756ee1c0ab6661735f7c17af562b8e1c Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Wed, 28 Oct 2026 13:56:50 +0000
Subject: [PATCH] VideoPlayer: fall back to software when DRMPRIME has no
 usable format

When the hwaccel cannot be initialised (e.g. VP9 profile 2 on a decoder
that only supports profile 0), FFmpeg offers its software format, but
DRMPRIME accepts only 8-bit software formats. GetFormat() then returns
no format, every packet fails and playback stays black, while the
codec factory would have chosen the FFmpeg software decoder had
DRMPRIME failed in Open().

Request a re-open from DRMPRIME once no format is usable, let
Reopen() report that the decoder cannot continue, and re-open the
stream with CODEC_FORCE_SOFTWARE so the factory creates the FFmpeg
decoder.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h |  4 +++-
 .../DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp          |  9 +++++++++
 .../DVDCodecs/Video/DVDVideoCodecDRMPRIME.h            |  3 +++
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp            |  3 ++-
 .../VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h  |  2 +-
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp            | 10 +++++++++-
 6 files changed, 27 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
index 08933a0c10..ca3ff3fce7 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
@@ -252,8 +252,10 @@ public:
   /**
    * Re-open the decoder.
    * Decoder request to re-open
+   * Returns false if the decoder cannot decode the stream, so a software decoder
+   * is opened instead
    */
-  virtual void Reopen() {}
+  virtual bool Reopen() { return true; }
 
 protected:
   CProcessInfo &m_processInfo;
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp
index d80c57fc18..28b84c2541 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp
@@ -232,6 +232,8 @@ enum AVPixelFormat CDVDVideoCodecDRMPRIME::GetFormat(struct AVCodecContext* avct
   CLog::Log(LOGERROR, "CDVDVideoCodecDRMPRIME::{} - no supported pixel formats: {}", __FUNCTION__,
             StringUtils::Join(formats, ", "));
 
+  static_cast<CDVDVideoCodecDRMPRIME*>(avctx->opaque)->m_noSupportedFormat = true;
+
   return AV_PIX_FMT_NONE;
 }
 
@@ -454,6 +456,10 @@ bool CDVDVideoCodecDRMPRIME::AddData(const DemuxPacket& packet)
   av_buffer_unref(&avpkt->buf);
   av_free(avpkt);
 
+  // consume the packet so GetPicture() can request a software decoder
+  if (m_noSupportedFormat)
+    return true;
+
   if (ret == AVERROR(EAGAIN))
     return false;
   else if (ret)
@@ -949,6 +955,9 @@ std::string CDVDVideoCodecDRMPRIME::GetFilterChain(bool interlaced)
 
 CDVDVideoCodec::VCReturn CDVDVideoCodecDRMPRIME::GetPicture(VideoPicture* pVideoPicture)
 {
+  if (m_noSupportedFormat)
+    return VC_REOPEN;
+
   if (m_codecControlFlags & DVD_CODEC_CTRL_DRAIN)
     Drain();
 
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.h
index 585bba258b..3055a4ef59 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.h
@@ -12,6 +12,7 @@
 #include "cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h"
 #include "cores/VideoPlayer/DVDStreamInfo.h"
 
+#include <atomic>
 #include <memory>
 
 extern "C"
@@ -38,6 +39,7 @@ public:
   const char* GetName() override { return m_name.c_str(); }
   unsigned GetAllowedReferences() override { return 5; }
   void SetCodecControl(int flags) override;
+  bool Reopen() override { return false; }
 
 protected:
   void Drain();
@@ -59,6 +61,7 @@ protected:
   CDVDStreamInfo m_hints;
   double m_DAR = 1.0;
   bool m_checkedDeinterlace = false;
+  std::atomic<bool> m_noSupportedFormat{false};
   AVCodecContext* m_pCodecContext = nullptr;
   AVFrame* m_pFrame = nullptr;
   AVFrame* m_pFilterFrame = nullptr;
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index da85398def..1790be4cd8 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -995,13 +995,14 @@ void CDVDVideoCodecFFmpeg::Reset()
   m_dropCtrl.Reset(false);
 }
 
-void CDVDVideoCodecFFmpeg::Reopen()
+bool CDVDVideoCodecFFmpeg::Reopen()
 {
   Dispose();
   if (!Open(m_hints, m_options))
   {
     Dispose();
   }
+  return true;
 }
 
 CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::HandleHwFatal()
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
index b84fee9b0b..bd6ff18e3b 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
@@ -37,7 +37,7 @@ public:
   bool Open(CDVDStreamInfo &hints, CDVDCodecOptions &options) override;
   bool AddData(const DemuxPacket &packet) override;
   void Reset() override;
-  void Reopen() override;
+  bool Reopen() override;
   CDVDVideoCodec::VCReturn GetPicture(VideoPicture* pVideoPicture) override;
   const char* GetName() override { return m_name.c_str(); }; // m_name is never changed after open
   unsigned GetConvergeCount() override;
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index 94e97dd2e0..f274a8c0b8 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -657,7 +657,15 @@ bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
       SendMessage(msg, 10);
     }
 
-    m_pVideoCodec->Reopen();
+    if (!m_pVideoCodec->Reopen())
+    {
+      CLog::Log(LOGINFO, "CVideoPlayerVideo - {} cannot decode the stream, using software",
+                m_pVideoCodec->GetName());
+      CDVDStreamInfo hint(m_hints);
+      hint.codecOptions |= CODEC_FORCE_SOFTWARE;
+      m_pVideoCodec.reset();
+      OpenStream(hint, nullptr);
+    }
     m_packets.clear();
     m_renderManager.DiscardBuffer();
     return false;
-- 
