From 64cbd0fb64dcc969ea0802700c6aea650bc5e003 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sun, 25 Oct 2026 15:03:36 +0000
Subject: [PATCH 268/280] WIP: arm64: dts: rockchip: rk356x: run the video
 decoder at 400 MHz

The decoder AXI, core and CABAC clocks are assigned 297 MHz, which the
GPLL (1200 MHz) cannot divide to, so the PLL rounds down and the decoder
runs at 240 MHz (CABAC 250 MHz). That is too slow for 4K60.

Assign 400 MHz (GPLL/3), the highest decoder OPP in the vendor kernel,
which it runs at the default 900 mV vdd_logic.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 arch/arm64/boot/dts/rockchip/rk356x-base.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi b/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi
index 025d88849ed9..e090ae89416a 100644
--- a/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi
@@ -690,8 +690,8 @@ vdec: video-codec@fdf80100 {
 				  <&cru CLK_RKVDEC_CORE>,
 				  <&cru CLK_RKVDEC_CA>,
 				  <&cru CLK_RKVDEC_HEVC_CA>;
-		assigned-clock-rates = <297000000>, <297000000>,
-				       <297000000>, <600000000>;
+		assigned-clock-rates = <400000000>, <400000000>,
+				       <400000000>, <600000000>;
 		iommus = <&vdec_mmu>;
 		power-domains = <&power RK3568_PD_RKVDEC>;
 		resets = <&cru SRST_A_RKVDEC>, <&cru SRST_H_RKVDEC>,
-- 
