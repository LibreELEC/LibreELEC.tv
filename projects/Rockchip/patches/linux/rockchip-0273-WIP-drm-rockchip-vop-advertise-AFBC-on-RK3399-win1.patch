From 073b9d54a85990aaec8785827fc8c5dd3346e974 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Wed, 28 Oct 2026 09:59:02 +0000
Subject: [PATCH 273/280] WIP: drm/rockchip: vop: advertise AFBC on RK3399 win1

The RK3399 AFBC decoder can be assigned to any one window, but only win0
advertises it. win0 is the bottom layer, so an AFBC gui cannot be placed
above a video plane and no plane pair is found for video playback.

Advertise AFBC on win1 too. The CRTC check keeps a single AFBC plane.
RK3328 shared the win1 description and has no AFBC decoder, so give it
its own copy without the modifier.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/gpu/drm/rockchip/rockchip_vop_reg.c | 32 ++++++++++++++++++---
 1 file changed, 28 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/rockchip/rockchip_vop_reg.c b/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
index acd3c87d19f4..b5e6eedb8b0e 100644
--- a/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
+++ b/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
@@ -1031,7 +1031,7 @@ static const struct vop_win_phy rk3399_win1_data = {
 	.scl = &rk3288_win_full_scl,
 	.data_formats = formats_win_full_10,
 	.nformats = ARRAY_SIZE(formats_win_full_10),
-	.format_modifiers = format_modifiers_win_full,
+	.format_modifiers = format_modifiers_win_full_afbc,
 	.enable = VOP_REG(RK3399_WIN0_CTRL0, 0x1, 0),
 	.format = VOP_REG(RK3399_WIN0_CTRL0, 0x7, 1),
 	.fmt_10 = VOP_REG(RK3399_WIN0_CTRL0, 0x1, 4),
@@ -1199,12 +1199,36 @@ static const struct vop_intr rk3328_vop_intr = {
 	.clear = VOP_REG_MASK_SYNC(RK3328_INTR_CLEAR0, 0xffff, 0),
 };
 
+static const struct vop_win_phy rk3328_win_data = {
+	.scl = &rk3288_win_full_scl,
+	.data_formats = formats_win_full_10,
+	.nformats = ARRAY_SIZE(formats_win_full_10),
+	.format_modifiers = format_modifiers_win_full,
+	.enable = VOP_REG(RK3399_WIN0_CTRL0, 0x1, 0),
+	.format = VOP_REG(RK3399_WIN0_CTRL0, 0x7, 1),
+	.fmt_10 = VOP_REG(RK3399_WIN0_CTRL0, 0x1, 4),
+	.rb_swap = VOP_REG(RK3399_WIN0_CTRL0, 0x1, 12),
+	.uv_swap = VOP_REG(RK3399_WIN0_CTRL0, 0x1, 15),
+	.x_mir_en = VOP_REG(RK3399_WIN0_CTRL0, 0x1, 21),
+	.y_mir_en = VOP_REG(RK3399_WIN0_CTRL0, 0x1, 22),
+	.act_info = VOP_REG(RK3399_WIN0_ACT_INFO, 0x1fff1fff, 0),
+	.dsp_info = VOP_REG(RK3399_WIN0_DSP_INFO, 0x0fff0fff, 0),
+	.dsp_st = VOP_REG(RK3399_WIN0_DSP_ST, 0x1fff1fff, 0),
+	.yrgb_mst = VOP_REG(RK3399_WIN0_YRGB_MST, 0xffffffff, 0),
+	.uv_mst = VOP_REG(RK3399_WIN0_CBR_MST, 0xffffffff, 0),
+	.yrgb_vir = VOP_REG(RK3399_WIN0_VIR, 0x3fff, 0),
+	.uv_vir = VOP_REG(RK3399_WIN0_VIR, 0x3fff, 16),
+	.src_alpha_ctl = VOP_REG(RK3399_WIN0_SRC_ALPHA_CTRL, 0xff, 0),
+	.dst_alpha_ctl = VOP_REG(RK3399_WIN0_DST_ALPHA_CTRL, 0xff, 0),
+	.channel = VOP_REG(RK3399_WIN0_CTRL2, 0xff, 0),
+};
+
 static const struct vop_win_data rk3328_vop_win_data[] = {
-	{ .base = 0xd0, .phy = &rk3399_win1_data,
+	{ .base = 0xd0, .phy = &rk3328_win_data,
 	  .type = DRM_PLANE_TYPE_PRIMARY },
-	{ .base = 0x1d0, .phy = &rk3399_win1_data,
+	{ .base = 0x1d0, .phy = &rk3328_win_data,
 	  .type = DRM_PLANE_TYPE_OVERLAY },
-	{ .base = 0x2d0, .phy = &rk3399_win1_data,
+	{ .base = 0x2d0, .phy = &rk3328_win_data,
 	  .type = DRM_PLANE_TYPE_CURSOR },
 };
 
