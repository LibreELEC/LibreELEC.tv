From 5d9c2d9647ca09e1eb65cf3ae486b0ec1dee2906 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Mon, 26 Oct 2026 01:37:54 +0000
Subject: [PATCH 162/280] fixup! WIP: drm/bridge: dw-hdmi: scale CSC offsets
 for deep-color output

The CSC offset terms do not depend on the output colour depth: the
coefficient tables already encode them relative to the CSC scale, and
the hardware applies the depth itself. Shifting them for 10-bit output
lifts black in limited-range RGB output.

Revert the offset scaling.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c | 9 ---------
 1 file changed, 9 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index e5e8f9c41671..e79497c5b619 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -1119,12 +1119,10 @@ static void dw_hdmi_update_csc_coeffs(struct dw_hdmi *hdmi)
 	const u16 (*csc_coeff)[3][4] = &csc_coeff_default;
 	bool is_input_rgb, is_output_rgb, is_limited_range = true;
 	unsigned i;
-	int depth;
 	u32 csc_scale = 1;
 
 	is_input_rgb = hdmi_bus_fmt_is_rgb(hdmi->hdmi_data.enc_in_bus_format);
 	is_output_rgb = hdmi_bus_fmt_is_rgb(hdmi->hdmi_data.enc_out_bus_format);
-	depth = hdmi_bus_fmt_color_depth(hdmi->hdmi_data.enc_out_bus_format);
 
 	if (!is_input_rgb && is_output_rgb) {
 		if (hdmi->hdmi_data.enc_out_encoding == V4L2_YCBCR_ENC_601)
@@ -1152,13 +1150,6 @@ static void dw_hdmi_update_csc_coeffs(struct dw_hdmi *hdmi)
 		u16 coeff_b = (*csc_coeff)[1][i];
 		u16 coeff_c = (*csc_coeff)[2][i];
 
-		/* Scale CSC coeffs to match output color depth */
-		if (i == 3 && depth > 8) {
-			coeff_a <<= depth - 8;
-			coeff_b <<= depth - 8;
-			coeff_c <<= depth - 8;
-		}
-
 		hdmi_writeb(hdmi, coeff_a & 0xff, HDMI_CSC_COEF_A1_LSB + i * 2);
 		hdmi_writeb(hdmi, coeff_a >> 8, HDMI_CSC_COEF_A1_MSB + i * 2);
 		hdmi_writeb(hdmi, coeff_b & 0xff, HDMI_CSC_COEF_B1_LSB + i * 2);
-- 
