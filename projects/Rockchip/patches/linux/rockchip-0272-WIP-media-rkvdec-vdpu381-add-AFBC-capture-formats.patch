+static int rkvdec_g_selection(struct file *file, void *priv,
+			      struct v4l2_selection *s)
+{
+	struct rkvdec_ctx *ctx = file_to_rkvdec_ctx(file);
+	const struct v4l2_pix_format_mplane *pix_mp = &ctx->decoded_fmt.fmt.pix_mp;
