From a8e536064834597086e1a94aeabf8e612766cccb Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Fri, 2 Oct 2026 05:58:23 +0000
Subject: [PATCH 239/280] WIP: drm/bridge: dw-hdmi: always enable the HDCP
 keep-out window

The frame composer enables the HDCP keep-out window only when HDCP is
in use or the link is scrambled. With the window disabled, HBR audio
such as Dolby TrueHD glitches on every mode below 340 MHz, while the
scrambled modes, which enable it, play cleanly.

Enable the keep-out window for every mode.

Fixes: 9aaf880ed4ee ("imx-drm: Add mx6 hdmi transmitter support")

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index b88d74f6d0f8..a91ebeb93f18 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -1887,10 +1887,7 @@ static void hdmi_av_composer(struct dw_hdmi *hdmi,
 	dev_dbg(hdmi->dev, "final tmdsclock = %d\n", vmode->mtmdsclock);
 
 	/* Set up HDMI_FC_INVIDCONF */
-	inv_val = (hdmi->hdmi_data.hdcp_enable ||
-		   conn_state->hdmi.scrambler_needed ?
-		HDMI_FC_INVIDCONF_HDCP_KEEPOUT_ACTIVE :
-		HDMI_FC_INVIDCONF_HDCP_KEEPOUT_INACTIVE);
+	inv_val = HDMI_FC_INVIDCONF_HDCP_KEEPOUT_ACTIVE;
 
 	inv_val |= mode->flags & DRM_MODE_FLAG_PVSYNC ?
 		HDMI_FC_INVIDCONF_VSYNC_IN_POLARITY_ACTIVE_HIGH :
