From 0cbef8ad970a7b0bd40556d52efb9d8f4e87e6de Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Mon, 26 Oct 2026 05:11:56 +0000
Subject: [PATCH 261/280] WIP: ASoC: rockchip: i2s-tdm: add the HDMI IEC958
 transport for dw-hdmi

The RK3568 HDMI TX (DesignWare HDMI) cannot flag inserted channel status
as non-audio, so compressed pass-through is sent as PCM. In NLPCM mode it
takes the PCUV bits from the I2S samples, in its own BPCUV layout.

On HDMI links of SoCs with this transmitter, translate ALSA IEC958
subframes into that layout in the copy path, deriving B from the Z
preamble, and keep IEC958 subframes out of mmap access so the
translation cannot be bypassed.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 sound/soc/rockchip/rockchip_i2s_tdm.c | 135 +++++++++++++++++++++++++-
 1 file changed, 134 insertions(+), 1 deletion(-)

diff --git a/sound/soc/rockchip/rockchip_i2s_tdm.c b/sound/soc/rockchip/rockchip_i2s_tdm.c
index 9e6deadb20c3..1193aac7d3d8 100644
--- a/sound/soc/rockchip/rockchip_i2s_tdm.c
+++ b/sound/soc/rockchip/rockchip_i2s_tdm.c
@@ -15,13 +15,22 @@
 #include <linux/regmap.h>
 #include <linux/reset.h>
 #include <linux/spinlock.h>
+#include <sound/asoundef.h>
 #include <sound/dmaengine_pcm.h>
+#include <sound/hdmi-codec.h>
 #include <sound/pcm_params.h>
 
 #include "rockchip_i2s_tdm.h"
 
 #define DRV_NAME "rockchip-i2s-tdm"
 
+#define I2S_HDMI_PREAMBLE_B	0x8
+#define I2S_HDMI_PAYLOAD_MASK	GENMASK(27, 12)
+#define I2S_HDMI_PCUV_MASK	(IEC958_SUBFRAME_PARITY | \
+				 IEC958_SUBFRAME_CHANNEL_STATUS | \
+				 IEC958_SUBFRAME_USER_DATA | \
+				 IEC958_SUBFRAME_VALIDITY)
+
 #define DEFAULT_MCLK_FS				256
 #define CH_GRP_MAX				4  /* The max channel 8 / 2 */
 #define MULTIPLEX_CH_MAX			10
@@ -44,6 +53,7 @@ struct rk_i2s_soc_data {
 	int config_count;
 	const struct txrx_config *configs;
 	int (*init)(struct device *dev, u32 addr);
+	bool hdmi_bpcuv;
 };
 
 struct rk_i2s_tdm_dev {
@@ -170,6 +180,13 @@ static inline struct rk_i2s_tdm_dev *to_info(struct snd_soc_dai *dai)
 	return snd_soc_dai_get_drvdata(dai);
 }
 
+static bool rockchip_i2s_tdm_is_hdmi(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+
+	return snd_soc_rtdcom_lookup(rtd, HDMI_CODEC_DRV_NAME) != NULL;
+}
+
 /*
  * Makes sure that both tx and rx are reset at the same time to sync lrck
  * when clk_trcm > 0.
@@ -857,8 +874,75 @@ static int rockchip_i2s_tdm_set_bclk_ratio(struct snd_soc_dai *dai,
 	return 0;
 }
 
+static int rockchip_i2s_tdm_rule_access(struct snd_pcm_hw_params *params,
+					struct snd_pcm_hw_rule *rule)
+{
+	const struct snd_mask *format =
+		hw_param_mask_c(params, SNDRV_PCM_HW_PARAM_FORMAT);
+	struct snd_mask *access = hw_param_mask(params, SNDRV_PCM_HW_PARAM_ACCESS);
+	struct snd_mask allowed;
+
+	if (!snd_mask_single(format) ||
+	    !snd_mask_test_format(format, SNDRV_PCM_FORMAT_IEC958_SUBFRAME_LE))
+		return 0;
+
+	snd_mask_copy(&allowed, access);
+	snd_mask_reset(&allowed, SNDRV_PCM_ACCESS_MMAP_INTERLEAVED);
+	snd_mask_reset(&allowed, SNDRV_PCM_ACCESS_MMAP_NONINTERLEAVED);
+	snd_mask_reset(&allowed, SNDRV_PCM_ACCESS_MMAP_COMPLEX);
+
+	return snd_mask_refine(access, &allowed);
+}
+
+static int rockchip_i2s_tdm_rule_format(struct snd_pcm_hw_params *params,
+					struct snd_pcm_hw_rule *rule)
+{
+	const struct snd_mask *access =
+		hw_param_mask_c(params, SNDRV_PCM_HW_PARAM_ACCESS);
+	struct snd_mask *format = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
+	struct snd_mask allowed;
+
+	if (snd_mask_test(access, SNDRV_PCM_ACCESS_RW_INTERLEAVED) ||
+	    snd_mask_test(access, SNDRV_PCM_ACCESS_RW_NONINTERLEAVED))
+		return 0;
+
+	snd_mask_copy(&allowed, format);
+	snd_mask_reset(&allowed,
+		       (__force unsigned int)SNDRV_PCM_FORMAT_IEC958_SUBFRAME_LE);
+
+	return snd_mask_refine(format, &allowed);
+}
+
+/*
+ * The IEC958 subframes are rewritten for the HDMI transmitter in the copy
+ * path, so keep them out of mmap access.
+ */
+static int rockchip_i2s_tdm_startup(struct snd_pcm_substream *substream,
+				    struct snd_soc_dai *dai)
+{
+	struct rk_i2s_tdm_dev *i2s_tdm = to_info(dai);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	int ret;
+
+	if (!i2s_tdm->soc_data || !i2s_tdm->soc_data->hdmi_bpcuv ||
+	    substream->stream != SNDRV_PCM_STREAM_PLAYBACK ||
+	    !rockchip_i2s_tdm_is_hdmi(substream))
+		return 0;
+
+	ret = snd_pcm_hw_rule_add(runtime, 0, SNDRV_PCM_HW_PARAM_ACCESS,
+				  rockchip_i2s_tdm_rule_access, NULL,
+				  SNDRV_PCM_HW_PARAM_FORMAT, -1);
+	if (ret)
+		return ret;
+
+	return snd_pcm_hw_rule_add(runtime, 0, SNDRV_PCM_HW_PARAM_FORMAT,
+				   rockchip_i2s_tdm_rule_format, NULL,
+				   SNDRV_PCM_HW_PARAM_ACCESS, -1);
+}
+
 static const struct snd_soc_dai_ops rockchip_i2s_tdm_dai_ops = {
 	.probe = rockchip_i2s_tdm_dai_probe,
+	.startup = rockchip_i2s_tdm_startup,
 	.hw_params = rockchip_i2s_tdm_hw_params,
 	.set_bclk_ratio	= rockchip_i2s_tdm_set_bclk_ratio,
 	.set_fmt = rockchip_i2s_tdm_set_fmt,
@@ -867,6 +951,50 @@ static const struct snd_soc_dai_ops rockchip_i2s_tdm_dai_ops = {
 	.trigger = rockchip_i2s_tdm_trigger,
 };
 
+/*
+ * The DesignWare HDMI TX samples IEC958 data on I2S as B, P, C, U and V
+ * followed by the 16-bit payload. Move the payload and the PCUV bits of
+ * ALSA's IEC958 subframes into that layout and derive B from the Z preamble.
+ */
+static int rockchip_i2s_tdm_hdmi_process(struct snd_pcm_substream *substream,
+					 int channel, unsigned long hwoff,
+					 unsigned long bytes)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	__le32 *ptr = (__le32 *)(runtime->dma_area + hwoff +
+		channel * (runtime->dma_bytes / runtime->channels));
+	__le32 *end = (__le32 *)((u8 *)ptr + bytes);
+
+	if (runtime->format != SNDRV_PCM_FORMAT_IEC958_SUBFRAME_LE)
+		return 0;
+
+	if (!rockchip_i2s_tdm_is_hdmi(substream))
+		return -EINVAL;
+
+	if (bytes % sizeof(*ptr))
+		return -EINVAL;
+
+	for (; ptr < end; ptr++) {
+		u32 sample = le32_to_cpu(*ptr);
+		u32 hdmi = (sample & I2S_HDMI_PAYLOAD_MASK) >> 1;
+
+		hdmi |= (sample & I2S_HDMI_PCUV_MASK) >> 1;
+
+		if ((sample & IEC958_SUBFRAME_PREAMBLE_MASK) ==
+		    I2S_HDMI_PREAMBLE_B)
+			hdmi |= BIT(31);
+
+		*ptr = cpu_to_le32(hdmi);
+	}
+
+	return 0;
+}
+
+static const struct snd_dmaengine_pcm_config rockchip_i2s_tdm_hdmi_pcm_config = {
+	.prepare_slave_config = snd_dmaengine_pcm_prepare_slave_config,
+	.process = rockchip_i2s_tdm_hdmi_process,
+};
+
 static const struct snd_soc_component_driver rockchip_i2s_tdm_component = {
 	.name = DRV_NAME,
 	.legacy_dai_naming = 1,
@@ -1049,6 +1177,7 @@ static const struct rk_i2s_soc_data rk3568_i2s_soc_data = {
 	.configs = rk3568_txrx_config,
 	.config_count = ARRAY_SIZE(rk3568_txrx_config),
 	.init = common_soc_init,
+	.hdmi_bpcuv = true,
 };
 
 static const struct rk_i2s_soc_data rv1126_i2s_soc_data = {
@@ -1396,7 +1525,11 @@ static int rockchip_i2s_tdm_probe(struct platform_device *pdev)
 	if (ret)
 		goto err_suspend;
 
-	ret = devm_snd_dmaengine_pcm_register(&pdev->dev, NULL, 0);
+	if (i2s_tdm->soc_data && i2s_tdm->soc_data->hdmi_bpcuv)
+		ret = devm_snd_dmaengine_pcm_register(&pdev->dev,
+				&rockchip_i2s_tdm_hdmi_pcm_config, 0);
+	else
+		ret = devm_snd_dmaengine_pcm_register(&pdev->dev, NULL, 0);
 	if (ret)
 		goto err_suspend;
 
-- 
