mkdir -p $RELEASE_DIR/3rdparty/bootloader

VENDOR_IMX="${PROJECT_DIR}/${PROJECT}/devices/${DEVICE}/vendor/imx-boot"
if [ -s "${VENDOR_IMX}/imx-boot" ]; then
  cp -a "${VENDOR_IMX}/imx-boot" $RELEASE_DIR/3rdparty/bootloader/flash.bin
elif [ -s "${VENDOR_IMX}/flash.bin" ]; then
  cp -a "${VENDOR_IMX}/flash.bin" $RELEASE_DIR/3rdparty/bootloader/flash.bin
elif [ -n "$UBOOT_SYSTEM" ] && [ -s "$(get_build_dir $BOOTLOADER)/flash.bin" ]; then
  cp -a $(get_build_dir $BOOTLOADER)/flash.bin $RELEASE_DIR/3rdparty/bootloader/
fi

if [ -f "${PROJECT_DIR}/${PROJECT}/devices/${DEVICE}/bootloader/boot-emmc.cmd" ]; then
  cp -a "${PROJECT_DIR}/${PROJECT}/devices/${DEVICE}/bootloader/boot-emmc.cmd" \
    $RELEASE_DIR/3rdparty/bootloader/boot-emmc.cmd
fi

cp -a $(get_build_dir linux)/arch/$TARGET_KERNEL_ARCH/boot/dts/freescale/*.dtb $RELEASE_DIR/3rdparty/bootloader
