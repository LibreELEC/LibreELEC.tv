# i.MX8MP: ATF + OP-TEE + LPDDR4 training firmware for imx-mkimage iMX8M.
# Do not copy i.MX8MQ Cadence HDMI (HDMI=no on iMX8MP).
# Do not copy iMX8QX SCFW / AHAB — that SoC is not this board.

[ -n "$ATF_PLATFORM" ] && cp -av $(get_install_dir atf)/usr/share/bootloader/bl31.bin .

cp -av $(get_install_dir optee-os)/usr/share/bootloader/tee.bin $(get_build_dir $BOOTLOADER)/

cp -av $(get_build_dir firmware-imx)/firmware/ddr/synopsys/lpddr4_pmu_train_[12]d_{i,d}mem_202006.bin $(get_build_dir $BOOTLOADER)/
