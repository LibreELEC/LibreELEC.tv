From: LibreELEC VAR-DART-IMX8MP
Subject: [PATCH] arm64: dts: dt8mcustomboard: BCM4339 WiFi/BT (SOM 1.x)

This SOM is 1.3 with BCM4339. The base DTB describes IW612 + nxp,88w8987-bt.
Yocto applies imx8mp-var-dart-1.x.dtbo; LE boot.scr loads a flat DTB, so
hci0 HCI_RESET times out. Disable IW612 and attach brcm,bcm43438-bt.

--- a/arch/arm64/boot/dts/freescale/imx8mp-var-dart-dt8mcustomboard.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-var-dart-dt8mcustomboard.dts
@@ -876,3 +876,35 @@
 		>;
 	};
 };
+
+/* SOM 1.x/1.3: BCM4339. Yocto applies imx8mp-var-dart-1.x.dtbo; we do not. */
+&bluetooth_iw61x {
+	status = "disabled";
+};
+
+&iw612_pwrseq {
+	status = "disabled";
+};
+
+&reg_eqos_phy {
+	gpio = <&gpio2 20 GPIO_ACTIVE_HIGH>;
+};
+
+&usdhc1 {
+	/delete-property/ mmc-pwrseq;
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	brcmf: wifi@1 {
+		reg = <1>;
+		compatible = "brcm,bcm4329-fmac";
+	};
+};
+
+&uart4 {
+	bluetooth {
+		compatible = "brcm,bcm43438-bt";
+		shutdown-gpios = <&gpio2 6 GPIO_ACTIVE_HIGH>;
+		max-speed = <3000000>;
+	};
+};
