From 9ead026a2667d21add9b1f1407772f9793c309d4 Mon Sep 17 00:00:00 2001
From: Chris <chris.dixon.78.burnbridge@gmail.com>
Date: Fri, 21 Aug 2026 11:25:31 +0100
Subject: [PATCH 1/3] Build fixes for modern toolchains and GBM targets

Missing <string>/<system_error> includes that gcc 13+ no longer supplies
transitively, and use libOpenGL directly when FindOpenGL cannot find GLX.
---
 cmake/SearchForStuff.cmake    | 13 +++++++++++++
 pcsx2/CDVD/CDVDdiscReader.h   |  1 +
 pcsx2/CDVD/CDVDdiscThread.cpp |  1 +
 3 files changed, 15 insertions(+)

diff --git a/cmake/SearchForStuff.cmake b/cmake/SearchForStuff.cmake
index da6eba91e..14533ba60 100644
--- a/cmake/SearchForStuff.cmake
+++ b/cmake/SearchForStuff.cmake
@@ -15,6 +15,19 @@ find_package(LibLZMA)
 # is deprecated as of cmake 3.11.
 set(OpenGL_GL_PREFERENCE GLVND)
 find_package(OpenGL)
+
+# No GLX on a GBM/EGL target, which is the only thing FindOpenGL was missing.
+# libOpenGL exports the same entry points, so link that directly.
+if(NOT OPENGL_FOUND)
+    find_library(OPENGL_opengl_LIBRARY NAMES OpenGL)
+    if(OPENGL_opengl_LIBRARY)
+        set(OPENGL_FOUND TRUE)
+        set(OPENGL_LIBRARIES ${OPENGL_opengl_LIBRARY})
+        set(OPENGL_INCLUDE_DIR "")
+        message(STATUS "Using ${OPENGL_opengl_LIBRARY} directly: no GLX on this target")
+    endif()
+endif()
+
 find_package(PNG)
 set(wxWidgets_FOUND 1)
 set(wxWidgets_USE_FILE 3rdparty/wxwidgets3.0/UsewxWidgets.cmake)
diff --git a/pcsx2/CDVD/CDVDdiscReader.h b/pcsx2/CDVD/CDVDdiscReader.h
index ecc0e29f9..71ea4c732 100644
--- a/pcsx2/CDVD/CDVDdiscReader.h
+++ b/pcsx2/CDVD/CDVDdiscReader.h
@@ -23,6 +23,7 @@
 #endif
 
 #include <mutex>
+#include <string>
 #include <array>
 #include <memory> /* for unique_ptr */
 #include <vector>
diff --git a/pcsx2/CDVD/CDVDdiscThread.cpp b/pcsx2/CDVD/CDVDdiscThread.cpp
index 3619b8205..296891125 100644
--- a/pcsx2/CDVD/CDVDdiscThread.cpp
+++ b/pcsx2/CDVD/CDVDdiscThread.cpp
@@ -21,6 +21,7 @@
 #include <limits>
 #include <queue>
 #include <cstring> /* memcpy */
+#include <system_error>
 #include <thread>
 
 const u32 sectors_per_read = 16;
