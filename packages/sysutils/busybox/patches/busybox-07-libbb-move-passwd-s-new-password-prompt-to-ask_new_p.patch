From 3eb16544acf96cad6557fb0ec47941ef8aa610f5 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Thu, 5 Nov 2026 06:09:07 +0000
Subject: [PATCH 1/3] libbb: move passwd's new password prompt to
 ask_new_password()

Move the "New password:" / "Retype password:" prompting, weak password
check and encryption from passwd.c's new_password() to a libbb
function, so that other applets can ask for a new password the same
way. passwd keeps checking the old password itself.

No functional change.

Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
[LE: on top of busybox-06-prevent-root-weak-passwd, weak passwords
 are refused for root as well (allow_weak 0)]
---
 include/libbb.h          |  3 +++
 libbb/ask_new_password.c | 56 ++++++++++++++++++++++++++++++++++++++++
 loginutils/passwd.c      | 32 +----------------------
 3 files changed, 60 insertions(+), 31 deletions(-)
 create mode 100644 libbb/ask_new_password.c

diff --git a/include/libbb.h b/include/libbb.h
index 01cdb1bdc..08228f77b 100644
--- a/include/libbb.h
+++ b/include/libbb.h
@@ -1790,6 +1790,9 @@ int ask_and_check_password(const struct passwd *pw) FAST_FUNC;
 #endif
 extern char *pw_encrypt(const char *clear, const char *salt, int cleanup) FAST_FUNC;
 extern int obscure(const char *old, const char *newval, const struct passwd *pwdp) FAST_FUNC;
+/* Returns a malloced encrypted password, or NULL */
+char *ask_new_password(const struct passwd *pw,
+		const char *orig, int allow_weak, const char *algo) FAST_FUNC;
 /*
  * rnd is additional random input. New one is returned.
  * Useful if you call crypt_make_salt many times in a row:
diff --git a/libbb/ask_new_password.c b/libbb/ask_new_password.c
new file mode 100644
index 000000000..e81baf410
--- /dev/null
+++ b/libbb/ask_new_password.c
@@ -0,0 +1,56 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * Ask the user for a new password and return it encrypted.
+ *
+ * Licensed under GPLv2 or later, see file LICENSE in this source tree.
+ */
+//kbuild:lib-$(CONFIG_PASSWD) += ask_new_password.o
+
+#include "libbb.h"
+
+/* Prompt (twice) for a new password for PW.
+ * ORIG is the old plaintext password if known (may be NULL),
+ * it is used only by the weak password check.
+ * If ALLOW_WEAK is zero, passwords failing the weak check are rejected.
+ * Returns the new password encrypted with ALGO (malloced),
+ * or NULL on failure.
+ */
+char* FAST_FUNC ask_new_password(const struct passwd *pw,
+		const char *orig, int allow_weak, const char *algo)
+{
+	char salt[MAX_PW_SALT_LEN];
+	char *newp;
+	char *cp = NULL;
+	char *ret = NULL; /* failure so far */
+
+	newp = bb_ask_noecho_stdin("New password: "); /* returns malloced str */
+	if (!newp)
+		goto err_ret;
+	if (ENABLE_FEATURE_PASSWD_WEAK_CHECK
+	 && obscure(orig, newp, pw) /* NB: passing NULL orig is ok */
+	 && !allow_weak
+	) {
+		goto err_ret;
+	}
+
+	cp = bb_ask_noecho_stdin("Retype password: ");
+	if (!cp)
+		goto err_ret;
+	if (strcmp(cp, newp) != 0) {
+		puts("Passwords don't match");
+		goto err_ret;
+	}
+
+	crypt_make_pw_salt(salt, algo);
+
+	/* pw_encrypt returns malloced str */
+	ret = pw_encrypt(newp, salt, 1);
+	/* whee, success! */
+
+ err_ret:
+	nuke_str(newp);
+	free(newp);
+	nuke_str(cp);
+	free(cp);
+	return ret;
+}
