From 0be88414a40e6522967c428eecfdb6714ad1e6b3 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Thu, 5 Nov 2026 06:11:10 +0000
Subject: [PATCH 3/3] login: force a password change if the password is expired

A last password change date of 0 in /etc/shadow ("passwd -e USER")
means the password must be changed before the user may log in. With
PAM, login already handles this via pam_chauthtok(), but without PAM
it was ignored and the user logged in with the old password.

Add FEATURE_PASSWD_LOGIN_FORCE_CHG: after successful authentication, if
the change date is 0 the user must enter a new password before the
session starts. There are 3 attempts, each with a fresh LOGIN_TIMEOUT;
weak passwords are rejected for non-root users, as in passwd. If no new
password is set, login is denied. The new password is written to
/etc/shadow with the current date.

ask_new_password() gains an OLD_HASH argument so that login can
reject the current password as the "new" one.

Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
[LE: on top of busybox-06-prevent-root-weak-passwd, weak passwords
 are refused for root as well (allow_weak 0)]
---
 include/libbb.h          |  3 +-
 libbb/Kbuild.src         |  1 +
 libbb/ask_new_password.c | 15 ++++++++-
 libbb/update_passwd.c    |  1 +
 loginutils/chpasswd.c    |  2 +-
 loginutils/login.c       | 72 ++++++++++++++++++++++++++++++++++++++++
 loginutils/passwd.c      |  2 +-
 7 files changed, 92 insertions(+), 4 deletions(-)

diff --git a/include/libbb.h b/include/libbb.h
index f1871c228..ecb7c17fd 100644
--- a/include/libbb.h
+++ b/include/libbb.h
@@ -1792,7 +1792,8 @@ extern char *pw_encrypt(const char *clear, const char *salt, int cleanup) FAST_F
 extern int obscure(const char *old, const char *newval, const struct passwd *pwdp) FAST_FUNC;
 /* Returns a malloced encrypted password, or NULL */
 char *ask_new_password(const struct passwd *pw,
-		const char *orig, int allow_weak, const char *algo) FAST_FUNC;
+		const char *orig, const char *old_hash,
+		int allow_weak, const char *algo) FAST_FUNC;
 /*
  * rnd is additional random input. New one is returned.
  * Useful if you call crypt_make_salt many times in a row:
diff --git a/libbb/Kbuild.src b/libbb/Kbuild.src
index cb8d2c2ec..9cccecce7 100644
--- a/libbb/Kbuild.src
+++ b/libbb/Kbuild.src
@@ -161,6 +161,7 @@ lib-$(CONFIG_SULOGIN) += pw_encrypt.o correct_password.o
 lib-$(CONFIG_VLOCK) += pw_encrypt.o correct_password.o
 lib-$(CONFIG_SU) += pw_encrypt.o correct_password.o
 lib-$(CONFIG_LOGIN) += pw_encrypt.o correct_password.o
+lib-$(CONFIG_FEATURE_PASSWD_LOGIN_FORCE_CHG) += update_passwd.o
 lib-$(CONFIG_FEATURE_HTTPD_AUTH_MD5) += pw_encrypt.o
 lib-$(CONFIG_FEATURE_FTP_AUTHENTICATION) += pw_encrypt.o
 
diff --git a/libbb/ask_new_password.c b/libbb/ask_new_password.c
index e81baf410..11cb92f15 100644
--- a/libbb/ask_new_password.c
+++ b/libbb/ask_new_password.c
@@ -1,22 +1,26 @@
 /* vi: set sw=4 ts=4: */
 /*
  * Ask the user for a new password and return it encrypted.
+ * Shared by passwd and login.
  *
  * Licensed under GPLv2 or later, see file LICENSE in this source tree.
  */
 //kbuild:lib-$(CONFIG_PASSWD) += ask_new_password.o
+//kbuild:lib-$(CONFIG_FEATURE_PASSWD_LOGIN_FORCE_CHG) += ask_new_password.o
 
 #include "libbb.h"
 
 /* Prompt (twice) for a new password for PW.
  * ORIG is the old plaintext password if known (may be NULL),
  * it is used only by the weak password check.
+ * If OLD_HASH is not NULL, a new password matching it is rejected.
  * If ALLOW_WEAK is zero, passwords failing the weak check are rejected.
  * Returns the new password encrypted with ALGO (malloced),
  * or NULL on failure.
  */
 char* FAST_FUNC ask_new_password(const struct passwd *pw,
-		const char *orig, int allow_weak, const char *algo)
+		const char *orig, const char *old_hash,
+		int allow_weak, const char *algo)
 {
 	char salt[MAX_PW_SALT_LEN];
 	char *newp;
@@ -32,6 +36,15 @@ char* FAST_FUNC ask_new_password(const struct passwd *pw,
 	) {
 		goto err_ret;
 	}
+	if (old_hash && old_hash[0]) {
+		char *encrypted = pw_encrypt(newp, old_hash, 1);
+		int same = (strcmp(encrypted, old_hash) == 0);
+		free(encrypted);
+		if (same) {
+			puts("The password has not been changed");
+			goto err_ret;
+		}
+	}
 
 	cp = bb_ask_noecho_stdin("Retype password: ");
 	if (!cp)
diff --git a/libbb/update_passwd.c b/libbb/update_passwd.c
index cd2c0c9f2..d403d53fb 100644
--- a/libbb/update_passwd.c
+++ b/libbb/update_passwd.c
@@ -267,6 +267,7 @@ static int update_passwd_common(const char *filename,
 #endif
 		if ((ENABLE_PASSWD && applet_name[0] == 'p')
 		 || (ENABLE_CHPASSWD && applet_name[0] == 'c')
+		 || (ENABLE_FEATURE_PASSWD_LOGIN_FORCE_CHG && applet_name[0] == 'l')
 		) {
 			/* Change passwd */
 			cp = strchrnul(cp, ':'); /* move past old passwd */
diff --git a/loginutils/chpasswd.c b/loginutils/chpasswd.c
index 65530b614..6f3f1ee5e 100644
--- a/loginutils/chpasswd.c
+++ b/loginutils/chpasswd.c
@@ -15,7 +15,7 @@
 //config:config FEATURE_DEFAULT_PASSWD_ALGO
 //config:	string "Default encryption method (passwd -a, cryptpw -m, chpasswd -c ALG)"
 //config:	default "des"
-//config:	depends on PASSWD || CRYPTPW || CHPASSWD
+//config:	depends on PASSWD || CRYPTPW || CHPASSWD || FEATURE_PASSWD_LOGIN_FORCE_CHG
 //config:	help
 //config:	Possible choices are "d[es]", "m[d5]", "s[ha256]" or "sha512".
 
diff --git a/loginutils/login.c b/loginutils/login.c
index 301be4a34..75f9f2cdc 100644
--- a/loginutils/login.c
+++ b/loginutils/login.c
@@ -47,6 +47,17 @@
 //config:	The file /etc/securetty is used by (some versions of) login(1).
 //config:	The file contains the device names of tty lines (one per line,
 //config:	without leading /dev/) on which root is allowed to login.
+//config:
+//config:config FEATURE_PASSWD_LOGIN_FORCE_CHG
+//config:	bool "Force password change if password is expired"
+//config:	default y
+//config:	depends on LOGIN && FEATURE_SHADOWPASSWDS && !PAM
+//config:	help
+//config:	If the last password change date in /etc/shadow is 0,
+//config:	the user must choose a new password before the login
+//config:	session starts. Set it with "passwd -e USER" to force
+//config:	a password change on first login.
+//config:	(With PAM, this is handled by pam_unix and pam_chauthtok).
 
 //applet:/* Needs to be run by root or be suid root - needs to change uid and gid: */
 //applet:IF_LOGIN(APPLET(login, BB_DIR_BIN, BB_SUID_REQUIRE))
@@ -204,6 +215,63 @@ static void initselinux(char *username, char *full_tty,
 }
 #endif
 
+#if ENABLE_FEATURE_PASSWD_LOGIN_FORCE_CHG
+/* "passwd -e USER" (or "chage -d 0 USER") sets the last password change
+ * date in /etc/shadow to 0, meaning: password must be changed
+ * before the user is allowed to log in. Typically used to force
+ * a password change on first login.
+ */
+static void change_expired_password_or_die(const struct passwd *pw, const char *fromhost)
+{
+	struct spwd spw;
+	struct spwd *result = NULL;
+	char buffer[256];
+	int tries;
+
+	/* getspnam_r may return 0 yet set result to NULL */
+	if (getspnam_r(pw->pw_name, &spw, buffer, sizeof(buffer), &result) != 0
+	 || !result
+	 || result->sp_lstchg != 0
+	) {
+		return; /* no shadow entry, or password is not expired */
+	}
+
+	puts("You are required to change your password immediately");
+	syslog(LOG_NOTICE, "password change required for '%s'%s",
+				pw->pw_name, fromhost);
+	for (tries = 0; tries < 3; tries++) {
+		char *newp;
+
+		/* Give the user a fresh timeout for each attempt */
+		alarm(G.timeout);
+		newp = ask_new_password(pw, /*orig:*/ NULL, result->sp_pwdp,
+				/*allow_weak:*/ 0,
+				CONFIG_FEATURE_DEFAULT_PASSWD_ALGO);
+		if (!newp)
+			continue;
+		if (update_passwd(bb_path_shadow_file, pw->pw_name, newp, NULL) > 0) {
+			nuke_str(newp);
+			free(newp);
+			alarm(0);
+			syslog(LOG_INFO, "password for '%s' changed%s",
+					pw->pw_name, fromhost);
+			puts("Password changed");
+			return;
+		}
+		nuke_str(newp);
+		free(newp);
+		bb_error_msg("can't update password file %s", bb_path_shadow_file);
+		break;
+	}
+	puts("Password unchanged, login denied");
+	syslog(LOG_WARNING, "expired password for '%s' not changed%s",
+				pw->pw_name, fromhost);
+	exit(EXIT_FAILURE);
+}
+#else
+# define change_expired_password_or_die(pw, fromhost) ((void)0)
+#endif
+
 #if ENABLE_LOGIN_SCRIPTS
 static void run_login_script(struct passwd *pw, char *full_tty)
 {
@@ -528,6 +596,10 @@ int login_main(int argc UNUSED_PARAM, char **argv)
 		username[0] = '\0';
 	} /* while (1) */
 
+	/* Authenticated, but the password may need changing first.
+	 * (PAM did it above via pam_chauthtok). */
+	change_expired_password_or_die(pw, fromhost);
+
 	alarm(0);
 	/* We can ignore /etc/nologin if we are logging in as root,
 	 * it doesn't matter whether we are run by root or not */
diff --git a/loginutils/passwd.c b/loginutils/passwd.c
index 6ef370d99..620029860 100644
--- a/loginutils/passwd.c
+++ b/loginutils/passwd.c
@@ -64,7 +64,7 @@ static char* new_password(const struct passwd *pw, uid_t myuid, const char *algo
 		if (ENABLE_FEATURE_CLEAN_UP)
 			free(encrypted);
 	}
-	ret = ask_new_password(pw, orig, /*allow_weak:*/ 0, algo);
+	ret = ask_new_password(pw, orig, /*old_hash:*/ NULL, /*allow_weak:*/ 0, algo);
 
  err_ret:
 	nuke_str(orig);
-- 
