From 19c2d50feb58f689100d53048976fdc42efbb767 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Thu, 5 Nov 2026 06:10:09 +0000
Subject: [PATCH 2/3] passwd: add -e to expire a password

A last password change date of 0 in /etc/shadow means the user must
change their password at next login. shadow-utils sets it with
"passwd -e USER" (or "chage -d 0 USER"); add the same option, which
is commonly used to provision an account with a preset password that
has to be replaced on first login.

-e is root only, needs a username and shadow passwords. It keeps the
password and only sets the change date to 0, via a new
update_passwd_expire() variant of update_passwd(). It fails if the
user has no /etc/shadow entry, as the expiry can't be recorded in
/etc/passwd.

Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 include/libbb.h       |  6 ++++++
 libbb/update_passwd.c | 37 ++++++++++++++++++++++++++++++-------
 loginutils/passwd.c   | 29 ++++++++++++++++++++++++++---
 3 files changed, 62 insertions(+), 10 deletions(-)

diff --git a/include/libbb.h b/include/libbb.h
index 08228f77b..f1871c228 100644
--- a/include/libbb.h
+++ b/include/libbb.h
@@ -1816,6 +1816,12 @@ extern int update_passwd(const char *filename,
 		const char *username,
 		const char *data,
 		const char *member) FAST_FUNC;
+/* Like update_passwd(FILE, USER, NEW_PASSWD, NULL), but for /etc/shadow
+ * sets the last password change date to 0: the password must be changed
+ * at next login. Returns number of lines changed, or -1 on error */
+extern int update_passwd_expire(const char *filename,
+		const char *username,
+		const char *data) FAST_FUNC;
 
 int index_in_str_array(const char *const string_array[], const char *key) FAST_FUNC;
 int index_in_strings(const char *strings, const char *key) FAST_FUNC;
diff --git a/libbb/update_passwd.c b/libbb/update_passwd.c
index a228075cc..cd2c0c9f2 100644
--- a/libbb/update_passwd.c
+++ b/libbb/update_passwd.c
@@ -83,10 +83,11 @@ static void check_selinux_update_passwd(const char *username)
 
  Returns number of lines changed, or -1 on error.
 */
-int FAST_FUNC update_passwd(const char *filename,
+static int update_passwd_common(const char *filename,
 		const char *name,
 		const char *new_passwd,
-		const char *member)
+		const char *member UNUSED_PARAM,
+		int expire)
 {
 #if !(ENABLE_FEATURE_ADDUSER_TO_GROUP || ENABLE_FEATURE_DEL_USER_FROM_GROUP)
 #define member NULL
@@ -273,11 +274,16 @@ int FAST_FUNC update_passwd(const char *filename,
 			if (shadow && *cp == ':') {
 				/* /etc/shadow's field 3 (passwd change date) needs updating */
 				/* move past old change date */
-				unsigned time_days = (unsigned long)(time(NULL)) / (24*60*60);
-
-				if (time_days == 0) {
-					/* 0 as change date has special meaning, avoid it */
-					time_days = 1;
+				unsigned time_days = 0;
+
+				/* 0 as change date has special meaning:
+				 * "user must change password at next login" */
+				if (!expire) {
+					time_days = (unsigned long)(time(NULL)) / (24*60*60);
+					if (time_days == 0) {
+						/* avoid the special meaning */
+						time_days = 1;
+					}
 				}
 				cp = strchrnul(cp + 1, ':');
 				/* "name:" + "new_passwd" + ":" + "change date" + ":rest of line" */
@@ -338,3 +344,20 @@ int FAST_FUNC update_passwd(const char *filename,
 	free(name_colon);
 	return ret;
 }
+
+int FAST_FUNC update_passwd(const char *filename,
+		const char *name,
+		const char *new_passwd,
+		const char *member)
+{
+	return update_passwd_common(filename, name, new_passwd, member, /*expire:*/ 0);
+}
+
+#if ENABLE_PASSWD && ENABLE_FEATURE_SHADOWPASSWDS
+int FAST_FUNC update_passwd_expire(const char *filename,
+		const char *name,
+		const char *new_passwd)
+{
+	return update_passwd_common(filename, name, new_passwd, NULL, /*expire:*/ 1);
+}
+#endif
diff --git a/loginutils/passwd.c b/loginutils/passwd.c
index 7ab570e8b..6ef370d99 100644
--- a/loginutils/passwd.c
+++ b/loginutils/passwd.c
@@ -28,7 +28,7 @@
 //kbuild:lib-$(CONFIG_PASSWD) += passwd.o
 
 //usage:#define passwd_trivial_usage
-//usage:       "[-a ALG] [-dlu] [USER]"
+//usage:       "[-a ALG] [-dlu"IF_FEATURE_SHADOWPASSWDS("e")"] [USER]"
 //usage:#define passwd_full_usage "\n\n"
 //usage:       "Change USER's password (default: current user)"
 //usage:     "\n"
@@ -36,6 +36,9 @@
 //usage:     "\n	-d	Set password to ''"
 //usage:     "\n	-l	Lock (disable) account"
 //usage:     "\n	-u	Unlock (enable) account"
+//usage:	IF_FEATURE_SHADOWPASSWDS(
+//usage:     "\n	-e	Expire password: force change at next login"
+//usage:	)
 
 #include "libbb.h"
 #include <syslog.h>
@@ -77,7 +80,8 @@ int passwd_main(int argc UNUSED_PARAM, char **argv)
 		OPT_lock   = (1 << 1), /* -l - lock account */
 		OPT_unlock = (1 << 2), /* -u - unlock account */
 		OPT_delete = (1 << 3), /* -d - delete password */
-		OPT_lud    = OPT_lock | OPT_unlock | OPT_delete,
+		OPT_expire = (1 << 4) * ENABLE_FEATURE_SHADOWPASSWDS, /* -e - expire password */
+		OPT_lud    = OPT_lock | OPT_unlock | OPT_delete | OPT_expire,
 	};
 	unsigned opt;
 	int rc;
@@ -94,11 +98,12 @@ int passwd_main(int argc UNUSED_PARAM, char **argv)
 	/* Using _r function to avoid pulling in static buffers */
 	struct spwd spw;
 	char buffer[256];
+	smallint have_shadow = 0;
 #endif
 
 	logmode = LOGMODE_BOTH;
 	openlog(applet_name, 0, LOG_AUTH);
-	opt = getopt32(argv, "a:lud", &opt_a);
+	opt = getopt32(argv, "a:lud" IF_FEATURE_SHADOWPASSWDS("e"), &opt_a);
 	//argc -= optind;
 	argv += optind;
 
@@ -138,6 +143,7 @@ int passwd_main(int argc UNUSED_PARAM, char **argv)
 			 * no surprise there */
 		} else {
 			pw->pw_passwd = result->sp_pwdp;
+			have_shadow = 1;
 		}
 	}
 #endif
@@ -170,6 +176,16 @@ int passwd_main(int argc UNUSED_PARAM, char **argv)
 	} else if (opt & OPT_delete) {
 		newp = (char*)"";
 	}
+#if ENABLE_FEATURE_SHADOWPASSWDS
+	else if (opt & OPT_expire) {
+		/* Only /etc/shadow can record "must change at next login" */
+		if (!have_shadow)
+			bb_error_msg_and_die("can't expire password for %s: "
+					"no record in %s", name, bb_path_shadow_file);
+		/* Keep the password, set last change date to 0 */
+		newp = xstrdup(pw->pw_passwd);
+	}
+#endif
 
 	rlimit_fsize.rlim_cur = rlimit_fsize.rlim_max = 512L * 30000;
 	setrlimit(RLIMIT_FSIZE, &rlimit_fsize);
@@ -183,6 +199,13 @@ int passwd_main(int argc UNUSED_PARAM, char **argv)
 
 #if ENABLE_FEATURE_SHADOWPASSWDS
 	filename = bb_path_shadow_file;
+	if (opt & OPT_expire) {
+		if (update_passwd_expire(bb_path_shadow_file, name, newp) <= 0)
+			bb_error_msg_and_die("can't update password file %s", filename);
+		/* LOGMODE_BOTH */
+		bb_info_msg("password for %s expired by %s", name, myname);
+		return 0;
+	}
 	rc = update_passwd(bb_path_shadow_file, name, newp, NULL);
 	if (rc > 0)
 		/* password in /etc/shadow was updated */
-- 
