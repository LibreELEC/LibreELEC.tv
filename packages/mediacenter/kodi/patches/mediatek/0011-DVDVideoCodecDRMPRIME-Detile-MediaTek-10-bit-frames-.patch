+/*
+ * Copy a hardware frame into a DMA buffer of a software format through the
+ * hwcontext transfer (which detiles), so it takes the software buffer path.
+ */
+bool CDVDVideoCodecDRMPRIME::DownloadToDMA(AVPixelFormat format)
+{
+  const int size = av_image_get_buffer_size(format, m_pFrame->width, m_pFrame->height, 1);
+  if (size <= 0)
+    return false;
+
+  if (!m_swVideoBufferPool || !m_swVideoBufferPool->IsCompatible(format, size))
+  {
+    m_swVideoBufferPool = std::make_shared<CVideoBufferPoolDMA>();
+    m_swVideoBufferPool->Configure(format, size);
+  }
+  if (!m_swVideoBufferPool->IsConfigured())
+    return false;
+
+  CVideoBufferDMA* buffer = m_swVideoBufferPool->Get();
+  if (!buffer)
+    return false;
+
+  AVFrame* frame = av_frame_alloc();
+  if (!frame)
+  {
+    buffer->Release();
+    return false;
+  }
+
+  frame->format = format;
+  frame->width = m_pFrame->width;
+  frame->height = m_pFrame->height;
+  frame->opaque = static_cast<void*>(buffer);
+  frame->opaque_ref =
+      av_buffer_create(nullptr, 0, ReleaseBuffer, frame->opaque, AV_BUFFER_FLAG_READONLY);
+  buffer->Export(frame, frame->width, frame->height);
+  buffer->SyncStart();
+
+  if (av_hwframe_transfer_data(frame, m_pFrame, 0) < 0 || av_frame_copy_props(frame, m_pFrame) < 0)
+  {
+    av_frame_free(&frame);
+    return false;
+  }
+
+  // copy_props also copied the hardware frame's opaque
+  frame->opaque = static_cast<void*>(buffer);
+
+  av_frame_unref(m_pFrame);
+  av_frame_move_ref(m_pFrame, frame);
+  av_frame_free(&frame);
+  return true;
+}
+
 bool CDVDVideoCodecDRMPRIME::SetPictureParams(VideoPicture* pVideoPicture)
 {
   pVideoPicture->iWidth = m_pFrame->width;
@@ -1131,10 +1184,11 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecDRMPRIME::GetPicture(VideoPicture* pVideo
