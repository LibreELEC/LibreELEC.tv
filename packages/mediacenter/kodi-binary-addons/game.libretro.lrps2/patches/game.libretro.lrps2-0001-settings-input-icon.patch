+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+  LRPS2 advertises its pad as RETRO_DEVICE_JOYPAD ("DualShock 2" in the
+  retro_controller_description it registers), even though it reads the analog
+  axes through RETRO_DEVICE_ANALOG. The type here has to match what the core
+  advertises, not what the pad physically is: hand it RETRO_DEVICE_ANALOG and
+  retro_set_controller_port_device() gets a device the core does not know, and
+  no input reaches the game at all -- silently. The same mistake cost the
+  Dreamcast pad its input in game.libretro.flycast, which is the shape this
+  file follows.
+-->
+<buttonmap version="2">
+    <controller id="game.controller.ps.dualshock" type="RETRO_DEVICE_JOYPAD">
+        <feature name="cross" mapto="RETRO_DEVICE_ID_JOYPAD_B"/>
+        <feature name="circle" mapto="RETRO_DEVICE_ID_JOYPAD_A"/>
+        <feature name="square" mapto="RETRO_DEVICE_ID_JOYPAD_Y"/>
