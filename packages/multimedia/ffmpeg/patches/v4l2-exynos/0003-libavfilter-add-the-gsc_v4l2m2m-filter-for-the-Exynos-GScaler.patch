+#define FLAGS (AV_OPT_FLAG_FILTERING_PARAM | AV_OPT_FLAG_VIDEO_PARAM)
+static const AVOption gsc_v4l2m2m_options[] = {
+    { "w", "output width (0: no scaling)",  OFFSET(w), AV_OPT_TYPE_INT, { .i64 = 0 }, 0, 8192, FLAGS },
+    { "h", "output height (0: no scaling)", OFFSET(h), AV_OPT_TYPE_INT, { .i64 = 0 }, 0, 8192, FLAGS },
+    { NULL },
+};
+
