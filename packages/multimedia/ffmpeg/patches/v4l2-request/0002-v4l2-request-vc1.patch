+#include "config_components.h"
+
+#include "libavutil/intreadwrite.h"
+
+#include "hwaccel_internal.h"
+#include "hwconfig.h"
+#include "internal.h"
+#include "v4l2_request.h"
+#include "v4l2-stateless-vc1.h"
+#include "vc1.h"
+#include "vc1_common.h"
+#include "vc1data.h"
