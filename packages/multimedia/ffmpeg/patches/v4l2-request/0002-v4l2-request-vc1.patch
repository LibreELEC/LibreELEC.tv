+	__u8	fcm;
+	__u8	ptype[2];
+	__u8	refdist;
+	__u8	flags;
+	__u8	num_intcomp[2];
+	__u8	reserved;
+	struct v4l2_vc1_intcomp intcomp[2][V4L2_VC1_REFERENCE_NUM_INTCOMP];
+};
