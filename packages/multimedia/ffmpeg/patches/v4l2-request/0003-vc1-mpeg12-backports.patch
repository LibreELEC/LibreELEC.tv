Subject: [PATCH 2/4] avcodec/vc1: move the extradata header walk into vc1.c

vc1_decode_init() walks the markers of VC1/WVC1/WVP2 extradata and hands
every sequence header and entry point it finds to the readers in vc1.c.
The parser needs the same walk to know what a sequence header set before
it reads an entry point, so give it one place to call instead of a second
copy.

No functional change: the caller keeps the size check, the "Incomplete
extradata" rule and the sprite flag, and the walk returns the first error
it hits exactly as before.

(cherry picked from commit aa7d1596dbf6752c55bd1d2a4e3d79c46530f2c7)
---
 libavcodec/vc1.c    | 50 +++++++++++++++++++++++++++++++++++++++++++++
 libavcodec/vc1.h    | 16 +++++++++++++++
 libavcodec/vc1dec.c | 45 ++++------------------------------------
 3 files changed, 70 insertions(+), 41 deletions(-)

diff --git a/libavcodec/vc1.c b/libavcodec/vc1.c
index fc7b45d663f7..fa85aae2a5e1 100644
--- a/libavcodec/vc1.c
+++ b/libavcodec/vc1.c
@@ -26,6 +26,7 @@
  * VC-1 and WMV3 decoder common code
  */
 
+#include "libavutil/mem.h"
 #include "avcodec.h"
 #include "decode.h"
 #include "mpegvideo.h"
@@ -558,6 +559,55 @@ int ff_vc1_decode_entry_point(AVCodecContext *avctx, VC1Context *v, GetBitContex
     return 0;
 }
 
+int ff_vc1_decode_extradata(AVCodecContext *avctx, VC1Context *v,
+                            int *seq_initialized, int *ep_initialized)
+{
+    const uint8_t *start = avctx->extradata;
+    const uint8_t *end   = avctx->extradata + avctx->extradata_size;
+    const uint8_t *next;
+    uint8_t *buf2;
+    GetBitContext gb;
+    int ret = 0;
+
+    *seq_initialized = 0;
+    *ep_initialized  = 0;
+
+    buf2 = av_mallocz(avctx->extradata_size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!buf2)
+        return AVERROR(ENOMEM);
+
+    start = find_next_marker(start, end); // in WVC1 extradata first byte is its size, but can be 0 in mkv
+    next  = start;
+    for (; next < end; start = next) {
+        int size, buf2_size;
+
+        next = find_next_marker(start + 4, end);
+        size = next - start - 4;
+        if (size <= 0)
+            continue;
+        buf2_size = v->vc1dsp.vc1_unescape_buffer(start + 4, size, buf2);
+        ret = init_get_bits8(&gb, buf2, buf2_size);
+        if (ret < 0)
+            break;
+        switch (AV_RB32(start)) {
+        case VC1_CODE_SEQHDR:
+            if ((ret = ff_vc1_decode_sequence_header(avctx, v, &gb)) < 0)
+                goto end;
+            *seq_initialized = 1;
+            break;
+        case VC1_CODE_ENTRYPOINT:
+            if ((ret = ff_vc1_decode_entry_point(avctx, v, &gb)) < 0)
+                goto end;
+            *ep_initialized = 1;
+            break;
+        }
+    }
+
+end:
+    av_free(buf2);
+    return ret;
+}
+
 /* fill lookup tables for intensity compensation */
 #define INIT_LUT(lumscale, lumshift, luty, lutuv, chain) do {                 \
         int scale, shift, i;                                                  \
