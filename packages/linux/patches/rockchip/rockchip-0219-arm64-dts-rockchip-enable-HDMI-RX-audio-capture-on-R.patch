From bfebb9e1cb2a473f4d30ca15da8c1cdd9c80b706 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Wed, 14 Oct 2026 12:53:16 +0000
Subject: [PATCH 219/220] arm64: dts: rockchip: enable HDMI RX audio capture on
 Rock 5B

Enable the HDMI receiver, the shared HDMI RX sound card and the
i2s7_8ch interface it uses. Together with the audio capture support
in the snps_hdmirx driver this exposes a capture-only ALSA card fed
by the HDMI input. The receiver must be enabled for the card to bind
its codec DAI.

While here, alpha-sort nodes to improve readability.

Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 .../boot/dts/rockchip/rk3588-rock-5b.dts      | 38 ++++++++++++-------
 1 file changed, 25 insertions(+), 13 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts
index 7af53147bdd8..9ecd3afe234f 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts
@@ -9,6 +9,31 @@ / {
 	compatible = "radxa,rock-5b", "rockchip,rk3588";
 };
 
+&hdmi_receiver {
+	status = "okay";
+};
+
+&hdmi_receiver_sound {
+	status = "okay";
+};
+
+&i2s7_8ch {
+	status = "okay";
+};
+
+&pinctrl {
+	usb {
+		usbc_sbu_dc: usbc-sbu-dc {
+			rockchip,pins = <4 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>,
+					<4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		vcc5v0_host_en: vcc5v0-host-en {
+			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
+
 &sdio {
 	max-frequency = <200000000>;
 	no-sd;
@@ -36,19 +61,6 @@ &uart6 {
 	status = "okay";
 };
 
-&pinctrl {
-	usb {
-		usbc_sbu_dc: usbc-sbu-dc {
-			rockchip,pins = <4 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>,
-					<4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
-		};
-
-		vcc5v0_host_en: vcc5v0-host-en {
-			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
-		};
-	};
-};
-
 &usb_con {
 	power-role = "sink";
 };
-- 
