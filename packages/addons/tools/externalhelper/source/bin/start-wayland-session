ADDON_DIR=$(dirname "$(dirname "$0")")

if [ -n "${KODI_KEYBOARD_LAYOUT}" ]; then
  export XKB_DEFAULT_LAYOUT="${KODI_KEYBOARD_LAYOUT}"
fi

export XDG_RUNTIME_DIR="/run/user/$(id -u)"
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 0700 "${XDG_RUNTIME_DIR}"

EXTERNALHELPER_RUNTIME_DIR="${XDG_RUNTIME_DIR}/externalhelper"
mkdir -p "${EXTERNALHELPER_RUNTIME_DIR}"
chmod 0700 "${EXTERNALHELPER_RUNTIME_DIR}"

# Determine labwc config directory (check user override, fallback to addon default)
if [ -d "/storage/.config/labwc" ]; then
  LABWC_CONFIG_DIR="/storage/.config/labwc"
else
  LABWC_CONFIG_DIR="${ADDON_DIR}/labwc-config"
fi

# Generate session runner script for labwc primary client
SESSION_RUNNER="${EXTERNALHELPER_RUNTIME_DIR}/labwc-session-runner.sh"
echo '#!/bin/sh' > "${SESSION_RUNNER}"
printf 'exec "%s/bin/wayland-session-helper"' "${ADDON_DIR}" >> "${SESSION_RUNNER}"
for arg in "$@"; do
  escaped=$(printf '%s\n' "$arg" | sed "s/'/'\\\\''/g")
  printf " '%s'" "$escaped" >> "${SESSION_RUNNER}"
done
echo "" >> "${SESSION_RUNNER}"
chmod 0700 "${SESSION_RUNNER}"

dbus-run-session -- \
  "${ADDON_DIR}/bin/seatd-launch" -p "${ADDON_DIR}/bin/seatd" -- \
  "${ADDON_DIR}/bin/labwc" -C "${LABWC_CONFIG_DIR}" -S "${SESSION_RUNNER}"

rm -rf "${EXTERNALHELPER_RUNTIME_DIR}"
