RESOLV_CONF="/run/libreelec/resolv.conf"
CONNMAN_RESOLV_CONF="/run/connman/resolv.conf"
TMP_RESOLV_CONF="/run/tailscale/resolv.conf.tmp"
ACTIVE_MARKER="/run/tailscale/resolvconf-active"

restore_connman() {
  rm -f "$ACTIVE_MARKER"
  rm -f "$RESOLV_CONF"
  ln -s "$CONNMAN_RESOLV_CONF" "$RESOLV_CONF"
}

case "$1" in
  --version)
    echo "openresolv LibreELEC adapter"
    ;;
  --libreelec-prepare)
    mkdir -p "$(dirname $TMP_RESOLV_CONF)"
    rm -f "$ACTIVE_MARKER"
    {
      echo "# Generated by resolvconf"
      cat "$CONNMAN_RESOLV_CONF"
    } > "$TMP_RESOLV_CONF"
    chmod 644 "$TMP_RESOLV_CONF"
    rm -f "$RESOLV_CONF"
    mv "$TMP_RESOLV_CONF" "$RESOLV_CONF"
    ;;
  --libreelec-restore)
    restore_connman
    ;;
  -i)
    if [ -f "$CONNMAN_RESOLV_CONF" ]; then
      echo "connman"
    fi
    ;;
  -l)
    if [ "$2" = "connman" ]; then
      cat "$CONNMAN_RESOLV_CONF"
    else
      exit 1
    fi
    ;;
  *)
    ACTION=""
    NAME=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -a|-d)
          ACTION="$1"
          shift
          NAME="$1"
          ;;
      esac
      shift
    done

    case "$ACTION:$NAME" in
      -a:tailscale)
        cat > "$TMP_RESOLV_CONF"
        chmod 644 "$TMP_RESOLV_CONF"
        rm -f "$RESOLV_CONF"
        mv "$TMP_RESOLV_CONF" "$RESOLV_CONF"
        touch "$ACTIVE_MARKER"
        ;;
      -d:tailscale)
        if [ -f "$ACTIVE_MARKER" ]; then
          restore_connman
        fi
        ;;
      *)
        exit 1
        ;;
    esac
    ;;
esac
